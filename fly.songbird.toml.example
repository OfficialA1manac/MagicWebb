# ───────────────────────────────────────────────────────────────────────────────
# MagicWebb — Fly.io deployment configuration for Songbird canary network (PUBLIC TEMPLATE)
#
# One Fly app per network. Each network is a fully independent stack: its own
# app, its own Neon database, its own /ws, its own indexer. The backend
# enforces this — config.go validates exactly one CHAIN_ID per process — so
# "multi-network" is three deployments of one binary, never one process
# serving three chains.
#
# The REAL fly.toml is gitignored and generated in CI from the template for the
# network being deployed (see NETWORK in .github/workflows/deploy.yml).
#
# To deploy locally:
#   1. cp fly.songbird.toml.example fly.toml
#   2. Replace every CHANGE_ME_* placeholder with your actual values
#   3. fly deploy --remote-only --strategy rolling --build-arg REOWN_PROJECT_ID=...
#
# What is hardcoded here vs. what is a placeholder:
#   Hardcoded  — anything that IS the network: app name, chain id, public RPC
#                endpoints, the public hostname. These cannot vary between
#                deploys of this network without it being a different network.
#   CHANGE_ME_ — anything that varies per deployment: contract addresses, the
#                block to index from, the collections to track, the
#                WalletConnect project id. CI fills these from GitHub
#                repository variables; a local deploy fills them by hand.
#
# To set up CI deployment (GitHub Actions):
#   1. Add repository variables (Settings → Secrets and variables → Actions):
#      - NETWORK (coston2 | songbird | flare — selects this template)
#      - MARKETPLACE_ADDR, AUCTION_ADDR, OFFERBOOK_ADDR, NFT_ADDR, MARKETPLACE_MANAGER_ADDR
#      - TRACKED_COLLECTIONS, INDEX_FROM_BLOCK
#   2. Add repository secrets:
#      - FLY_API_TOKEN (Fly deploy token)
#      - REOWN_PROJECT_ID (WalletConnect project ID from cloud.reown.com)
#   3. Push to main — CI generates fly.toml and deploys automatically.
#
# Secrets set via `fly secrets set` (NOT in this file). A Fly secret overrides
# the matching [env] key at runtime, which is also how you point this app at a
# private RPC provider without putting the URL in a public repo:
#   POSTGRES_URL, JWT_SECRET, KEEPER_KEY, RPC_URL, RPC_URLS
#   WC_PROJECT_ID, READ_POOL_URL, SAFE_ADDR, PERSONAL_WALLET_ADDR
#   DISCORD_WEBHOOK_URL, PROMETHEUS_WEBHOOK_URL, SMTP_*
#   SENTRY_DSN, OTEL_EXPORTER_OTLP_ENDPOINT
#   (See backend/.env.example for the full list)
# ───────────────────────────────────────────────────────────────────────────────

app = "magicwebb-songbird"
primary_region = "sin"

[build]
  dockerfile = "Dockerfile"
  # REOWN_PROJECT_ID is passed via --build-arg in CI (fly deploy --build-arg REOWN_PROJECT_ID=...).
  # When deploying locally, pass it manually: fly deploy --build-arg REOWN_PROJECT_ID=your_id
  # The [build.args] block is intentionally empty — build args come from the CLI.

# ── Environment variables injected at runtime ──────────────────────────────
# Secrets (POSTGRES_URL, JWT_SECRET, KEEPER_KEY, etc.) are set via
# `fly secrets set` and are NOT listed here — they never appear in any
# committed file.
[env]
  ENV = "production"
  HTTP_ADDR = ":8080"
  # Soft memory limit for the Go runtime: GC works harder near the cap instead
  # of the 512mb machine OOM-killing the process. ~80% of [[vm]] memory.
  GOMEMLIMIT = "400MiB"
  # NETWORK_URLS (sibling deployments) is inserted here by CI from deployments/*.json.
  # REDIS_URL: set via `fly secrets set` to share cache/rate-limit state across
  # machines of THIS network. Unset = per-instance memory. Never share across networks.
  # GRPC_PORT/GRPC_PEERS: enable when running 2+ machines (event mesh + keeper election).

  # ── Network identity (Songbird canary network) ──
  CHAIN_ID = "19"
  # Only the canonical public endpoint is listed. Add more to RPC_URLS
  # (comma-separated) once you have verified them — RPC_URLS can only ADD to
  # the rotation, never drop RPC_URL from it.
  RPC_URL = "https://songbird-api.flare.network/ext/C/rpc"
  RPC_URLS = "https://songbird-api.flare.network/ext/C/rpc"
  SIWE_DOMAIN = "magicwebb-songbird.fly.dev"
  FRONTEND_URL = "https://magicwebb-songbird.fly.dev"
  # NETWORK_NAME / NATIVE_CURRENCY / EXPLORER_URL are deliberately NOT set.
  # backend/internal/chain/profile carries the correct Songbird values
  # (explorer https://songbird-explorer.flare.network, currency SGB), a test
  # cross-checks them against app/src/lib/chains.ts and deployments/*.json, and
  # config.go only falls back to the profile when the env var is empty. Setting
  # them here would create a second source of truth that goes stale silently.
  # RESET_ON_ADDRESS_CHANGE is also unset on purpose: this is a mainnet-class
  # network, so a contract-address change requires a deliberate manual chainwipe
  # rather than an automatic boot-time wipe of chain-derived tables.

  # Contract addresses come from deployments/<network>.json (CI fills them).
  # While that record says "not-deployed" they are filled with "" and the
  # backend boots in READ-ONLY NETWORK MODE: UI + API serve, no indexer or
  # keepers. The switcher on other networks links here only once deployed,
  # rendering it as unavailable rather than linking to an app with no contracts.
  MARKETPLACE_ADDR = "CHANGE_ME_MARKETPLACE_ADDR"
  AUCTION_ADDR = "CHANGE_ME_AUCTION_ADDR"
  OFFERBOOK_ADDR = "CHANGE_ME_OFFERBOOK_ADDR"
  NFT_ADDR = "CHANGE_ME_NFT_ADDR"
  MARKETPLACE_MANAGER_ADDR = "CHANGE_ME_MARKETPLACE_MANAGER_ADDR"

  # Optional read-replica pool (Neon read-only branch). Unset = primary only.
  # Each network has its OWN Neon project; never point two apps at one database.
  # READ_POOL_URL = "CHANGE_ME_READ_POOL_URL"

  # NFT contracts the indexer watches for Transfer events.
  TRACKED_COLLECTIONS = "CHANGE_ME_TRACKED_COLLECTIONS"
  INDEX_FROM_BLOCK = "CHANGE_ME_INDEX_FROM_BLOCK"

  # WalletConnect v2 project ID — also settable via `fly secrets set
  # WC_PROJECT_ID=...`, which takes precedence at runtime. CI injects it from
  # GitHub secrets so the build-arg is available at Docker build time.
  # Get yours at https://cloud.reown.com
  WC_PROJECT_ID = "CHANGE_ME_WC_PROJECT_ID"

[http_service]
  internal_port = 8080
  force_https = true
  # Indexer + keeper run in-process: the machine must never scale to zero.
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

[[vm]]
  size = "shared-cpu-1x"
  memory = "512mb"

[checks]
  [checks.health]
    type = "http"
    port = 8080
    path = "/healthz"
    interval = "30s"
    timeout = "5s"
    grace_period = "30s"
