# Reown / WalletConnect Project ID (required)
# Get yours at https://cloud.reown.com
PUBLIC_REOWN_PROJECT_ID=your_project_id_here

# Network switcher — the Astro frontend's mirror of the backend's
# NETWORK_URLS. Same `chainID=origin` format; a chain that is absent renders
# as unavailable rather than as a link to a deployment that does not exist.
# PUBLIC_CHAIN_ID identifies which entry is the current one (default 114).
# PUBLIC_CHAIN_ID=114
# PUBLIC_NETWORK_URLS=114=https://magicwebb.fly.dev,19=https://magicwebb-songbird.fly.dev
