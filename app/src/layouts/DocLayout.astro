---
// Wrapper for the markdown documents under src/pages/docs/.
//
// These were rendered at request time by the Go binary (goldmark against an
// embedded FS) and served through the HTMX template stack. Astro renders the
// same markdown at build time instead, so the pages cost nothing at runtime
// and carry no markdown dependency in the server. The nav's WalletConnect
// island below still loads the wallet bundle, keeping the header consistent
// with every other page.
//
// The document list itself lives in src/pages/docs/_registry.ts (one source
// for this sidebar and the docs index page). On ≤768px the list collapses
// into a <details> disclosure ("Documents ▾") so the document starts near
// the top of the screen instead of below eight nav links.
import BaseLayout from './BaseLayout.astro';
import WalletConnect from '../components/WalletConnect';
import { DOCS } from '../pages/docs/_registry';

const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? 'Docs';
const description = frontmatter?.description;
// `wide: true` in a document's frontmatter lifts the 68ch measure — the
// system breakdown's diagrams and matrices need the full column.
const wide = frontmatter?.wide === true;

const current = Astro.url.pathname.replace(/\/+$/, '').split('/').pop();
---

<BaseLayout title={title} description={description} activeNav="docs">
  <WalletConnect slot="wallet" client:only="react" />

  <div class={`doc-shell${wide ? ' is-wide' : ''}`}>
    <nav class="doc-nav" aria-label="Documents">
      <!-- Desktop: always-visible list. -->
      <div class="doc-nav-static">
        <p class="doc-nav-label">Documents</p>
        {DOCS.map((d) => (
          <a href={`/docs/${d.slug}/`} class={`doc-nav-link${d.slug === current ? ' is-current' : ''}`}
             aria-current={d.slug === current ? 'page' : undefined}>
            <span aria-hidden="true">{d.icon}</span>{d.title}
          </a>
        ))}
        <a href="/docs/api.yaml" class="doc-nav-link doc-nav-aux">
          <span aria-hidden="true">⤓</span>OpenAPI spec
        </a>
      </div>

      <!-- Mobile (≤768px): the same list behind a disclosure. -->
      <details class="doc-nav-disclosure">
        <summary>Documents <span aria-hidden="true">▾</span></summary>
        {DOCS.map((d) => (
          <a href={`/docs/${d.slug}/`} class={`doc-nav-link${d.slug === current ? ' is-current' : ''}`}
             aria-current={d.slug === current ? 'page' : undefined}>
            <span aria-hidden="true">{d.icon}</span>{d.title}
          </a>
        ))}
        <a href="/docs/api.yaml" class="doc-nav-link doc-nav-aux">
          <span aria-hidden="true">⤓</span>OpenAPI spec
        </a>
      </details>
    </nav>

    <article class={`doc-body${wide ? ' is-wide' : ''}`}>
      <slot />
    </article>
  </div>
</BaseLayout>

<script>
  // ```mermaid fences reach the page as <pre><code class="language-mermaid">
  // (astro.config excludes mermaid from shiki). Render them client-side, only
  // on pages that have one (dynamic import → its own chunk), in the active
  // colour scheme; re-render when the OS scheme or the header toggle flips.
  const codes = Array.from(document.querySelectorAll<HTMLElement>('.doc-body pre > code.language-mermaid'));
  if (codes.length) {
    const blocks = codes.map((code) => ({ pre: code.parentElement as HTMLElement, src: code.textContent ?? '' }));
    const mq = matchMedia('(prefers-color-scheme: dark)');
    const isDark = () => {
      const t = document.documentElement.dataset.theme;
      return t === 'dark' || (t !== 'light' && mq.matches);
    };
    let seq = 0;
    let gen = 0;
    const render = async () => {
      const my = ++gen;
      const mermaid = (await import('mermaid')).default;
      if (my !== gen) return;
      // Colours come from the site tokens so every diagram clears the same
      // 4.5:1 gate as the rest of the page in both schemes (mermaid's own dark
      // theme paints edge labels at 4.43:1).
      const css = getComputedStyle(document.documentElement);
      const tok = (name: string, fallback: string) => css.getPropertyValue(name).trim() || fallback;
      const dark = isDark();
      const text = tok('--text', dark ? '#f4f4f5' : '#18181b');
      const surface = tok('--surface-2', dark ? '#16161c' : '#f4f4f5');
      const surface1 = tok('--surface', dark ? '#0f0f13' : '#ffffff');
      const line = tok('--line-strong', dark ? 'rgba(255,255,255,.16)' : 'rgba(0,0,0,.16)');
      const accent = tok('--sky', '#7dd3fc');
      mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        darkMode: dark,
        securityLevel: 'strict',
        fontFamily: 'Inter, system-ui, sans-serif',
        fontSize: 14,
        themeVariables: {
          darkMode: dark,
          background: surface,
          mainBkg: surface1,
          primaryColor: surface1,
          primaryTextColor: text,
          primaryBorderColor: line,
          secondaryColor: surface1,
          secondaryTextColor: text,
          secondaryBorderColor: line,
          tertiaryColor: surface,
          tertiaryTextColor: text,
          tertiaryBorderColor: line,
          textColor: text,
          lineColor: accent,
          nodeBorder: line,
          clusterBkg: 'rgba(127,127,127,0.08)',
          clusterBorder: line,
          titleColor: text,
          edgeLabelBackground: surface,
          nodeTextColor: text,
          // state diagrams
          labelColor: text,
          labelBackgroundColor: surface,
          stateBkg: surface1,
          stateLabelColor: text,
          compositeBackground: surface,
          altBackground: surface,
          transitionColor: accent,
          transitionLabelColor: text,
          // sequence diagrams
          actorBkg: surface1,
          actorBorder: line,
          actorTextColor: text,
          actorLineColor: line,
          signalColor: accent,
          signalTextColor: text,
          labelBoxBkgColor: surface1,
          labelBoxBorderColor: line,
          labelTextColor: text,
          loopTextColor: text,
          noteBkgColor: surface1,
          noteBorderColor: line,
          noteTextColor: text,
          activationBkgColor: surface,
          activationBorderColor: line,
          sequenceNumberColor: text,
        },
      });
      for (const b of blocks) {
        try {
          const { svg } = await mermaid.render(`mw-mermaid-${seq++}`, b.src);
          if (my !== gen) return;
          let host = b.pre.previousElementSibling as HTMLElement | null;
          if (!host || !host.classList.contains('mermaid-diagram')) {
            host = document.createElement('figure');
            host.className = 'mermaid-diagram';
            b.pre.before(host);
          }
          host.innerHTML = svg;
          // mermaid emits width="100%" with max-width = the natural width, so a
          // wide diagram shrinks to the column and its labels shrink with it.
          // Below ~70 % keep the natural size and let the figure scroll sideways.
          const el = host.querySelector('svg');
          if (el) {
            const natural = parseFloat(el.style.maxWidth || '0');
            const avail = host.clientWidth - 32;
            if (natural > 0 && avail > 0 && avail / natural < 0.7) {
              el.style.width = `${natural}px`;
              el.style.maxWidth = 'none';
            }
          }
          b.pre.hidden = true;
        } catch (err) {
          b.pre.hidden = false; // leave the source readable
          console.warn('mermaid: diagram failed to render', b.src.slice(0, 40), err);
        }
      }
    };
    render();
    mq.addEventListener('change', () => { render(); });
    new MutationObserver(() => { render(); }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>

<style>
  .doc-shell {
    max-width: 74rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 6rem;
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .doc-shell { grid-template-columns: 15rem 1fr; }
    .doc-nav { position: sticky; top: 5rem; align-self: start; }
  }

  .doc-nav-static { display: flex; flex-direction: column; gap: 0.125rem; }
  .doc-nav-disclosure { display: none; }
  /* ≤768px: swap the flat list for the disclosure. */
  @media (max-width: 768px) {
    .doc-nav-static { display: none; }
    .doc-nav-disclosure {
      display: block;
      border: 1px solid var(--line-strong);
      border-radius: var(--r-card);
      background: var(--surface);
      padding: 0 0.5rem;
    }
    .doc-nav-disclosure summary {
      list-style: none;
      cursor: pointer;
      min-height: var(--hit);
      display: flex; align-items: center; gap: 0.375rem;
      padding: 0 0.5rem;
      font-size: 0.8125rem; font-weight: 700; color: var(--text-2);
    }
    .doc-nav-disclosure summary::-webkit-details-marker { display: none; }
    .doc-nav-disclosure[open] summary { border-bottom: 1px solid var(--line); }
    .doc-nav-disclosure .doc-nav-link { min-height: var(--hit); }
  }

  .doc-nav-label {
    font-size: 0.625rem; font-weight: 800; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--text-3);
    margin: 0 0 0.5rem 0.75rem;
  }
  .doc-nav-link {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.75rem; border-radius: 0.5rem;
    font-size: 0.8125rem; font-weight: 600;
    color: var(--white-60); transition: all 0.2s;
  }
  .doc-nav-link:hover { color: var(--text); background: var(--white-10); }
  .doc-nav-link.is-current { color: var(--link-strong); background: var(--sky-12); }
  .doc-nav-aux { color: var(--text-3); margin-top: 0.5rem; }

  /* Markdown body. Measure is capped so long prose stays readable. */
  .doc-body { min-width: 0; max-width: 68ch; color: var(--white-80); line-height: 1.7; }
  .doc-body :global(h1) {
    font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 900; letter-spacing: -0.025em;
    color: var(--text); margin: 0 0 1rem; text-wrap: balance;
  }
  .doc-body :global(h2) {
    font-size: 1.375rem; font-weight: 800; color: var(--text);
    margin: 2.5rem 0 0.75rem; padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--white-10); text-wrap: balance;
  }
  .doc-body :global(h3) { font-size: 1.0625rem; font-weight: 700; color: var(--text); margin: 1.75rem 0 0.5rem; }
  .doc-body :global(p) { margin: 0 0 1rem; }
  .doc-body :global(ul), .doc-body :global(ol) { margin: 0 0 1rem; padding-left: 1.35rem; }
  .doc-body :global(li) { margin: 0 0 0.4rem; }
  .doc-body :global(a) { color: var(--link-strong); text-decoration: underline; text-underline-offset: 2px; }
  .doc-body :global(strong) { color: var(--text); font-weight: 700; }
  .doc-body :global(hr) { border: none; border-top: 1px solid var(--white-10); margin: 2rem 0; }
  .doc-body :global(blockquote) {
    margin: 1.25rem 0; padding: 0.5rem 0 0.5rem 1rem;
    border-left: 3px solid rgba(167,139,250,0.5); color: var(--white-60);
  }
  .doc-body :global(code) {
    font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 0.85em;
    background: var(--white-10); border: 1px solid var(--white-10);
    border-radius: 4px; padding: 0.1em 0.35em;
  }
  /* Wide content scrolls inside its own box so the page never scrolls sideways. */
  .doc-body :global(pre) {
    background: var(--surface-2); border: 1px solid var(--white-10);
    border-radius: 0.75rem; padding: 1rem; overflow-x: auto; margin: 0 0 1.25rem;
  }
  .doc-body :global(pre code) { background: none; border: none; padding: 0; }
  .doc-body.is-wide { max-width: none; }
  /* Wide documents (diagrams, matrices) get the whole viewport, not 74rem. */
  .doc-shell.is-wide { max-width: 100rem; }
  /* Client-rendered mermaid diagrams (see the script above). */
  .doc-body :global(.mermaid-diagram) {
    margin: 0 0 1.25rem; padding: 1rem; background: var(--surface-2);
    border: 1px solid var(--white-10); border-radius: 0.75rem; overflow-x: auto;
  }
  .doc-body :global(.mermaid-diagram svg) { display: block; max-width: 100%; height: auto; margin: 0 auto; }
  /* Phones: a sequence diagram shrunk to 330px is unreadable and its labels
     spill past the shrunken svg; keep a readable width and let the figure scroll. */
  @media (max-width: 640px) { .doc-body :global(.mermaid-diagram svg) { min-width: 560px; } }
  .doc-body :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 1.25rem; font-size: 0.9375rem; display: block; overflow-x: auto; }
  .doc-body :global(th), .doc-body :global(td) {
    text-align: left; padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--white-10); vertical-align: top;
  }
  .doc-body :global(th) { color: var(--white-60); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; }
</style>
