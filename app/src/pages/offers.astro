---
import BaseLayout from '../layouts/BaseLayout.astro';
import WalletConnect from '../components/WalletConnect';
import OffersPage from '../components/OffersPage.svelte';
---

<BaseLayout title="Offers" description="Your buy and sell offers on MagicWebb NFT Marketplace" activeNav="/offers">
  <WalletConnect slot="wallet" client:only="react" />

  <section style="max-width:64rem;margin:0 auto;padding:1.5rem 1rem 3rem;">
    <h1 style="font-size:clamp(1.5rem,4vw,2rem);font-weight:800;color:var(--text);letter-spacing:-0.02em;margin-bottom:0.25rem;">Offers</h1>
    <p style="color:var(--white-40);font-size:0.875rem;margin-bottom:1.25rem;">Offers are escrowed and refundable. Sellers pay the 2% fee only when they accept.</p>
    <OffersPage client:load />
  </section>
</BaseLayout>
