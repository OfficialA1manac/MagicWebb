---
// Thin shell: the CollectionPage island owns header, stats, tabs, the
// owner-only offers toggle and every state (skeleton / 404 / error).
import BaseLayout from '../layouts/BaseLayout.astro';
import WalletConnect from '../components/WalletConnect';
import CollectionPage from '../components/CollectionPage.svelte';
---

<BaseLayout title="Collection" description="NFT Collection detail on MagicWebb" activeNav="/">
  <WalletConnect slot="wallet" client:only="react" />

  <section id="collection-page" style="max-width:80rem;margin:0 auto;padding:1.5rem 1rem 3rem;">
    <CollectionPage client:load />
  </section>
</BaseLayout>
