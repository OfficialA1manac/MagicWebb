---
import BaseLayout from '../layouts/BaseLayout.astro';
import WalletConnect from '../components/WalletConnect';
---

<BaseLayout title="Collection" description="NFT Collection detail on MagicWebb" activeNav="/">
  <WalletConnect slot="wallet" client:only="react" />

  <section id="collection-page" style="max-width:80rem;margin:0 auto;padding:2rem 1.5rem;">
    <div class="shimmer" style="display:flex;align-items:center;gap:1rem;margin-bottom:2rem;padding:1.5rem;border-radius:1.25rem;background:rgba(15,15,19,0.4);border:1px solid rgba(255,255,255,0.05);">
      <div style="width:4rem;height:4rem;border-radius:1rem;background:rgba(255,255,255,0.04);flex-shrink:0;"></div>
      <div style="flex:1;"><div class="skel-line" style="width:40%;height:1.25rem;margin-bottom:0.5rem;"></div><div class="skel-line" style="width:60%;height:0.75rem;"></div></div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:2rem;">
      <div class="shimmer" style="padding:1.5rem;border-radius:1rem;background:rgba(15,15,19,0.4);"><div class="skel-line w-50" style="height:0.75rem;margin-bottom:0.5rem;"></div><div class="skel-line w-30" style="height:1.5rem;"></div></div>
      <div class="shimmer" style="padding:1.5rem;border-radius:1rem;background:rgba(15,15,19,0.4);"><div class="skel-line w-50" style="height:0.75rem;margin-bottom:0.5rem;"></div><div class="skel-line w-30" style="height:1.5rem;"></div></div>
      <div class="shimmer" style="padding:1.5rem;border-radius:1rem;background:rgba(15,15,19,0.4);"><div class="skel-line w-50" style="height:0.75rem;margin-bottom:0.5rem;"></div><div class="skel-line w-30" style="height:1.5rem;"></div></div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;">
      <div class="shimmer" style="aspect-ratio:1;border-radius:1rem;background:rgba(15,15,19,0.4);"></div>
      <div class="shimmer" style="aspect-ratio:1;border-radius:1rem;background:rgba(15,15,19,0.4);"></div>
      <div class="shimmer" style="aspect-ratio:1;border-radius:1rem;background:rgba(15,15,19,0.4);"></div>
      <div class="shimmer" style="aspect-ratio:1;border-radius:1rem;background:rgba(15,15,19,0.4);"></div>
    </div>
  </section>

  <style>
    .skel-line{background:rgba(255,255,255,0.04);border-radius:0.25rem;}
    .w-50{width:50%;}.w-30{width:30%;}
    .shimmer{animation:shimmer-placeholder 1.5s ease-in-out infinite;}
    @keyframes shimmer-placeholder{0%{opacity:0.3;}50%{opacity:0.7;}100%{opacity:0.3;}}
  </style>

  <script is:inline>
    (function(){if(typeof window==='undefined')return;
      function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
      function weiToFLR(w,precision){try{const bi=BigInt(w||'0');const div=BigInt('1000000000000000000');const whole=(bi/div).toString();const prec=typeof precision==='number'?precision:2;const frac=(bi%div).toString().padStart(18,'0').slice(0,prec);return whole+'.'+frac;}catch(_){return precision===4?'0.0000':'0.00';}}
      function shortAddr(a){if(!a||a.length<10)return a;return a.slice(0,6)+'...'+a.slice(-4);}
      function resolveImageUri(uri,tid){if(!uri)return'';if(uri.startsWith('/api/v1/img/')||uri.startsWith('data:'))return uri;return'/api/v1/media?url='+encodeURIComponent(uri)+'&id='+encodeURIComponent(tid||'');}
      function cur(){return (typeof window!=='undefined'&&window.MW_NATIVE_CURRENCY)||'C2FLR';}

      const addr = window.location.pathname.replace('/collection/','').replace('/collection','');
      const root = document.getElementById('collection-page');
      if (!addr || addr.length<10) { if(root)root.innerHTML='<div style="text-align:center;padding:4rem;color:rgba(255,255,255,0.3);">Invalid collection address</div>'; return; }

      (async function(){
        try {
          const [colRes, listRes] = await Promise.all([
        fetch('/api/v1/collections/'+addr),
        fetch('/api/v1/listings?collection='+addr+'&limit=48')
      ]);
          const col = colRes.ok ? (await colRes.json()) : null;
          const listings = listRes.ok ? (await listRes.json()) : [];

          const name = (col&&col.name)||shortAddr(addr);
          const standard = (col&&col.standard)||'erc721';
          const verified = col&&col.verified;
          const creatorAddr = (col&&col.creator_addr)||'';
          const shortCreator = creatorAddr ? creatorAddr.slice(0,6)+'…'+creatorAddr.slice(-4) : '';
          const sym = col&&col.symbol||'';

          let floor = '0', vol24 = '0';
          const listedCount = Array.isArray(listings)?listings.length:0;
          if (Array.isArray(listings)&&listings.length) {
            let minWei=null,sumWei=0n;
            for(let i=0;i<listings.length;i++){try{const bi=BigInt(listings[i].price_wei||'0');if(bi>0n){if(minWei===null||bi<minWei)minWei=bi;sumWei+=bi;}}catch(_){}}
            if(minWei!==null)floor=weiToFLR(String(minWei));
            vol24=weiToFLR(String(sumWei));
          }

          root.innerHTML =
            '<div class="reveal">'+
              '<div style="display:flex;align-items:flex-start;gap:1rem;margin-bottom:2rem;padding:1.5rem;border-radius:1.25rem;background:rgba(15,15,19,0.6);border:1px solid rgba(255,255,255,0.07);">'+
                '<div style="width:4rem;height:4rem;border-radius:1rem;background:linear-gradient(135deg,rgba(125,211,252,0.2),rgba(14,165,233,0.1));display:flex;align-items:center;justify-content:center;font-size:2rem;border:1px solid rgba(125,211,252,0.25);flex-shrink:0;">🗂</div>'+
                '<div style="flex:1;min-width:0;">'+
                  '<h1 style="font-size:1.75rem;font-weight:800;color:#fafafa;display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">'+esc(name)+(verified?(creatorAddr?' <a class="vb is-ok md" href="/docs/faq#verified" title="Authentic — '+esc(name)+' by '+esc(shortCreator)+'. Standard NFT contract, metadata confirmed, creator known." aria-label="Authentic collection"><span class="vb-dot" aria-hidden="true">✓</span>Authentic</a>':' <a class="vb is-ok md" href="/docs/faq#verified" title="Verified NFT: standard NFT contract, metadata confirmed. Not a judgement of the art or the seller." aria-label="Verified NFT"><span class="vb-dot" aria-hidden="true">✓</span>Verified NFT</a>'):'')+(creatorAddr?' <a class="vb is-creator md" href="/docs/faq#creator" title="Collection creator of '+esc(name)+': this address ('+esc(shortCreator)+') is the on-chain owner of the collection contract." aria-label="Collection creator"><span class="vb-star" aria-hidden="true">★</span>Creator '+esc(shortCreator)+'</a>':'')+'</h1>'+
                  '<p style="font-size:0.75rem;color:rgba(255,255,255,0.3);font-family:JetBrains Mono,monospace;margin-top:0.25rem;">'+esc(addr)+' · '+esc(standard.toUpperCase())+(sym?' · '+esc(sym):'')+'</p>'+
                '</div>'+
              '</div>'+
              '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:2rem;">'+
                '<div style="padding:1.25rem;border-radius:1rem;background:rgba(15,15,19,0.6);border:1px solid rgba(252,211,77,0.2);"><p style="font-size:0.5625rem;color:rgba(255,255,255,0.35);text-transform:uppercase;font-weight:700;margin-bottom:0.375rem;">Floor</p><p style="font-size:1.5rem;font-weight:900;color:#fde68a;">'+esc(floor)+' <span style="font-size:0.75rem;opacity:0.6;">'+cur()+'</span></p></div>'+
                '<div style="padding:1.25rem;border-radius:1rem;background:rgba(15,15,19,0.6);border:1px solid rgba(125,211,252,0.2);"><p style="font-size:0.5625rem;color:rgba(255,255,255,0.35);text-transform:uppercase;font-weight:700;margin-bottom:0.375rem;">Total Listed Value</p><p style="font-size:1.5rem;font-weight:900;color:#7dd3fc;">'+esc(vol24)+' <span style="font-size:0.75rem;opacity:0.6;">'+cur()+'</span></p></div>'+
                '<div style="padding:1.25rem;border-radius:1rem;background:rgba(15,15,19,0.6);border:1px solid rgba(255,255,255,0.08);"><p style="font-size:0.5625rem;color:rgba(255,255,255,0.35);text-transform:uppercase;font-weight:700;margin-bottom:0.375rem;">Listed</p><p style="font-size:1.5rem;font-weight:900;color:#fafafa;">'+listedCount+'</p></div>'+
              '</div>'+
              '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;">'+
                '<h2 style="font-size:1.125rem;font-weight:800;color:#fafafa;">Listings</h2>'+
                '<span style="font-size:0.75rem;color:rgba(255,255,255,0.3);">'+listedCount+' item'+(listedCount!==1?'s':'')+'</span>'+
              '</div>'+
              (!Array.isArray(listings)||!listings.length
                ? '<div style="padding:4rem;text-align:center;color:rgba(255,255,255,0.2);border-radius:1rem;background:rgba(15,15,19,0.5);border:1px solid rgba(255,255,255,0.05);">No active listings in this collection</div>'
                : '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;">'+listings.map(function(l){
                    const price=weiToFLR(l.price_wei||'0',4);
                    const nm=l.name||('#'+l.token_id);
                    const img=resolveImageUri(l.image_uri,l.token_id);
                    const tid=l.token_id||'';
                    return '<a href="/token/'+esc(l.collection)+'/'+esc(tid)+'" class="tilt-card" style="display:block;background:rgba(15,15,19,0.6);border:1px solid rgba(255,255,255,0.07);border-radius:1rem;overflow:hidden;transition:all 0.3s;">'+
                      '<div style="aspect-ratio:1;overflow:hidden;background:rgba(9,9,11,0.5);position:relative;display:flex;align-items:center;justify-content:center;">'+
                        (img?'<img src="'+esc(img)+'" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\';">':'')+
                        '<span style="display:'+(img?'none':'flex')+';align-items:center;justify-content:center;font-size:3rem;color:rgba(255,255,255,0.08);">🖼</span>'+
                        '<div style="position:absolute;top:0.5rem;right:0.5rem;padding:0.25rem 0.625rem;border-radius:0.625rem;background:rgba(9,9,11,0.75);backdrop-filter:blur(8px);border:1px solid rgba(252,211,77,0.3);"><span style="font-size:0.75rem;font-weight:900;color:#fde68a;">'+esc(price)+'</span> <span style="font-size:0.5625rem;color:rgba(253,224,138,0.7);font-weight:700;">'+cur()+'</span></div>'+
                      '</div>'+
                      '<div style="padding:0.75rem;"><p style="font-size:0.5625rem;color:rgba(255,255,255,0.25);font-family:JetBrains Mono,monospace;">'+esc(shortAddr(l.collection))+'</p><p style="font-size:0.8125rem;font-weight:700;color:#fafafa;">'+esc(nm)+'</p></div>'+
                    '</a>';
                  }).join('')+'</div>')+
            '</div>';

          // Owner-only enable/disable-offers control (v3): shown when the
          // connected wallet is the collection's on-chain creator/owner.
          (function(){
            if (!creatorAddr) return;
            var meAddr = '';
            try { var st = localStorage.getItem('mw_addr') || ''; if (/^0x[0-9a-fA-F]{40}$/.test(st)) meAddr = st.toLowerCase(); } catch(_){}
            if (!meAddr || meAddr !== String(creatorAddr).toLowerCase()) return;
            function withMW(fn){ if (window.MW) { fn(window.MW); } else { window.addEventListener('mw-ready', function(){ fn(window.MW); }, { once: true }); } }
            withMW(function(mw){
              mw.isOfferEligible(addr).then(function(eligible){
                var host = document.createElement('div');
                host.style.cssText = 'margin:0 0 1.5rem;padding:1rem 1.25rem;border-radius:1rem;background:rgba(251,191,36,0.06);border:1px solid rgba(251,191,36,0.25);display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;';
                host.innerHTML = '<span style="font-size:0.8125rem;font-weight:700;color:#fde68a;">You created this collection.</span>'+
                  '<span style="font-size:0.75rem;color:rgba(255,255,255,0.5);">Offers are currently <b style="color:'+(eligible?'#86efac':'#fca5a5')+';">'+(eligible?'enabled':'disabled')+'</b>.</span>'+
                  '<button id="coll-offers-toggle" style="padding:0.45rem 1rem;border-radius:0.625rem;background:rgba(251,191,36,0.12);border:1px solid rgba(251,191,36,0.35);color:#fde68a;font-weight:700;font-size:0.75rem;cursor:pointer;font-family:inherit;">'+(eligible?'Disable offers':'Enable offers')+'</button>';
                var firstCard = root.querySelector('.reveal');
                if (firstCard && firstCard.children.length > 1) firstCard.insertBefore(host, firstCard.children[1]); else root.appendChild(host);
                var btn = document.getElementById('coll-offers-toggle');
                if (btn) btn.addEventListener('click', function(){
                  mw.setOfferEligible({ nft: addr, eligible: !eligible, name: name }).then(function(){ setTimeout(function(){ location.reload(); }, 1200); }).catch(function(){});
                });
              }).catch(function(){});
            });
          })();
        } catch(e) {
          if(root) root.innerHTML = '<div style="text-align:center;padding:4rem;color:#fca5a5;">Could not load this collection. Check your connection and try again.<br><br><button onclick="location.reload()" style="padding:0.5rem 1.5rem;border-radius:0.625rem;background:rgba(255,255,255,0.08);color:#fafafa;border:1px solid rgba(255,255,255,0.12);font-weight:700;cursor:pointer;font-family:inherit;">Retry</button></div>';
        }
      })();
    })();
  </script>
</BaseLayout>
