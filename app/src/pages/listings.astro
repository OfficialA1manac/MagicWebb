---
// Listings (spec B4): two Svelte islands own everything. ListingsFilters owns
// the URL state (?collection=&min=&max=&sort=&page=) and broadcasts it;
// NFTGrid fetches in place. No inline scripts, no duplicated helpers —
// formatting/badges come from lib/format.ts and lib/badge.ts inside the
// islands.
import BaseLayout from '../layouts/BaseLayout.astro';
import WalletConnect from '../components/WalletConnect';
import ListingsFilters from '../components/ListingsFilters.svelte';
import NFTGrid from '../components/NFTGrid.svelte';
---

<BaseLayout title="Listings" description="Browse active NFT listings on MagicWebb — buy, sell, and filter NFTs on Flare Network" activeNav="/listings">
  <WalletConnect slot="wallet" client:only="react" />

  <section style="max-width:80rem;margin:0 auto;padding:1.5rem 1rem 3rem;">
    <ListingsFilters client:load />
    <NFTGrid client:load />
  </section>
</BaseLayout>
