---
// /status (spec B4 "Metrics"): the old /metrics/gas dashboard renamed
// "Automation costs", plus indexer lag (from /api/v1/indexer/slo, Prometheus
// text format) and the running build SHA (X-MW-Build-SHA on /healthz).
// Linked from the footer only; /metrics/gas meta-refreshes here.
import BaseLayout from '../layouts/BaseLayout.astro';
import WalletConnect from '../components/WalletConnect';
---

<BaseLayout title="Status" description="MagicWebb service status — automation costs, indexer lag, and the running build." activeNav="metrics">
  <WalletConnect slot="wallet" client:only="react" />

  <section class="gas">
    <header class="gas-head">
      <h1>Status</h1>
      <p>What the automation costs to run, how far the indexer is behind, and which build is live.</p>
    </header>

    <h2>Service</h2>
    <div class="gas-tiles">
      <div class="tile"><span class="k">Indexer lag</span><span class="v" id="s-lag">—</span></div>
      <div class="tile"><span class="k">Build</span><span class="v" id="s-build">—</span></div>
    </div>

    <div id="gas-alerts" class="gas-alerts" hidden></div>

    <h2>Admin &amp; upgrades</h2>
    <p class="lead" id="gov-lead">Who can change the contracts on this network, and every time they did.</p>
    <div class="gas-tiles" id="gov-tiles">
      <div class="tile"><span class="k">Admin</span><span class="v" id="gov-admin">—</span><span class="sub" id="gov-admin-kind"></span></div>
      <div class="tile"><span class="k">Pending admin</span><span class="v" id="gov-pending">—</span></div>
      <div class="tile"><span class="k">Keeper</span><span class="v" id="gov-keeper">—</span></div>
      <div class="tile"><span class="k">Keeper balance</span><span class="v" id="gov-keeper-bal">—</span><span class="sub" id="gov-keeper-bal-sub"></span></div>
      <div class="tile"><span class="k">Upgrade delay</span><span class="v" id="gov-delay">—</span></div>
    </div>
    <div id="gov-alert" class="gas-alerts" hidden></div>
    <div class="tablewrap" id="gov-table">
      <table>
        <thead><tr><th>When</th><th>What happened</th><th>Who / what</th><th>Tx</th></tr></thead>
        <tbody id="gov-rows"><tr><td colspan="4" class="muted">Loading…</td></tr></tbody>
      </table>
    </div>

    <h2>Automation costs</h2>
    <div class="gas-tiles">
      <div class="tile"><span class="k">Transactions</span><span class="v" id="g-count">—</span></div>
      <div class="tile"><span class="k">Total spent</span><span class="v" id="g-total">—</span></div>
      <div class="tile"><span class="k">Avg per tx</span><span class="v" id="g-avg">—</span></div>
      <div class="tile"><span class="k">Avg gas price</span><span class="v" id="g-price">—</span></div>
      <div class="tile"><span class="k">Avg gas used</span><span class="v" id="g-used">—</span></div>
    </div>

    <h2>Where the gas goes</h2>
    <div id="gas-breakdown" class="gas-breakdown"><p class="muted">Loading…</p></div>

    <h2>Recent keeper transactions</h2>
    <div class="tablewrap">
      <table>
        <thead>
          <tr><th>Type</th><th>Tx</th><th>Gas used</th><th>Gas price</th><th>Cost</th></tr>
        </thead>
        <tbody id="gas-rows">
          <tr><td colspan="5" class="muted">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<script>
  const CUR = (window as any).MW_NATIVE_CURRENCY || 'C2FLR';
  const EXPLORER = (window as any).MW_EXPLORER || '';

  // Wei values arrive as decimal strings and can exceed Number.MAX_SAFE_INTEGER,
  // so the conversion goes through BigInt rather than parseFloat.
  function fmtWei(wei: string | number | null | undefined, dp = 4): string {
    try {
      const v = BigInt(String(wei ?? '0'));
      const whole = v / 10n ** 18n;
      const frac = (v % 10n ** 18n).toString().padStart(18, '0').slice(0, dp);
      return `${whole.toString()}.${frac} ${CUR}`;
    } catch {
      return `0 ${CUR}`;
    }
  }
  const esc = (s: unknown) =>
    String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);

  // ── Service tiles: indexer lag (Prometheus gauge) + build SHA ────────────
  async function loadService() {
    try {
      const r = await fetch('/api/v1/indexer/slo');
      const body = r.ok ? await r.text() : '';
      const m = body.match(/^head_lag_blocks\s+(\d+)/m);
      const el = document.getElementById('s-lag')!;
      el.textContent = m ? `${m[1]} block${m[1] === '1' ? '' : 's'}` : '—';
    } catch { /* tile keeps the dash */ }
    try {
      const r = await fetch('/healthz');
      const sha = r.headers.get('X-MW-Build-SHA') || '';
      document.getElementById('s-build')!.textContent = sha ? sha.slice(0, 12) : '—';
    } catch { /* tile keeps the dash */ }
  }

  async function load() {
    let data: any = null;
    try {
      const r = await fetch('/api/v1/metrics/gas');
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      data = await r.json();
    } catch {
      document.getElementById('gas-breakdown')!.innerHTML =
        '<p class="muted">Gas metrics are unavailable right now.</p>';
      document.getElementById('gas-rows')!.innerHTML =
        '<tr><td colspan="5" class="muted">Gas metrics are unavailable right now.</td></tr>';
      return;
    }

    const s = data.summary ?? {};
    const set = (id: string, v: string) => (document.getElementById(id)!.textContent = v);
    set('g-count', String(s.totalTxCount ?? 0));
    set('g-total', fmtWei(s.totalGasCostWei));
    set('g-avg', fmtWei(s.avgGasCostWei, 6));
    set('g-price', `${(s.avgGasPriceGwei ?? 0).toFixed(1)} gwei`);
    set('g-used', String(s.avgGasUsed ?? 0));

    const total = Number(s.totalTxCount ?? 0);
    const parts = [
      { label: 'Auction settlement', n: s.settleCount, wei: s.settleTotalCostWei, c: '#a78bfa' },
      { label: 'Loser refunds', n: s.refundLosersCount, wei: s.refundLosersTotalCostWei, c: '#7dd3fc' },
      { label: 'Fee sweeps', n: s.feeSweepCount, wei: s.feeSweepTotalCostWei, c: '#fcd34d' },
      { label: 'Offer refunds', n: s.refundOfferCount, wei: s.refundOfferTotalCostWei, c: '#34d399' },
    ];
    document.getElementById('gas-breakdown')!.innerHTML = total === 0
      ? '<p class="muted">No keeper transactions yet. Nothing has needed settling.</p>'
      : parts.map((p) => {
          const pct = total > 0 ? (Number(p.n ?? 0) / total) * 100 : 0;
          return `<div class="bar-row">
            <span class="bar-label">${esc(p.label)}</span>
            <span class="bar-track"><span class="bar-fill" style="width:${pct.toFixed(1)}%;background:${p.c}"></span></span>
            <span class="bar-val">${esc(p.n ?? 0)} · ${esc(fmtWei(p.wei))}</span>
          </div>`;
        }).join('');

    const logs = data.recentLogs ?? [];
    document.getElementById('gas-rows')!.innerHTML = logs.length === 0
      ? '<tr><td colspan="5" class="muted">No keeper transactions recorded.</td></tr>'
      : logs.map((l: any) => {
          const tx = esc(l.txHash ?? l.tx_hash ?? '');
          const short = tx ? `${tx.slice(0, 10)}…${tx.slice(-6)}` : '—';
          const link = tx && EXPLORER ? `<a href="${esc(EXPLORER)}/tx/${tx}" rel="noopener">${short}</a>` : short;
          return `<tr>
            <td>${esc(l.txType ?? l.tx_type ?? '')}</td>
            <td class="mono">${link}</td>
            <td class="mono">${esc(l.gasUsed ?? l.gas_used ?? 0)}</td>
            <td class="mono">${esc(l.effectiveGasPriceWei ?? l.effective_gas_price_wei ?? 0)}</td>
            <td class="mono">${esc(fmtWei(l.effectiveGasCostWei ?? l.effective_gas_cost_wei))}</td>
          </tr>`;
        }).join('');

    try {
      const ar = await fetch('/api/v1/metrics/gas/alerts');
      const alerts = ar.ok ? ((await ar.json()).alerts ?? []) : [];
      const box = document.getElementById('gas-alerts')!;
      if (alerts.length) {
        box.innerHTML = alerts.map((a: string) => `<p>⚠ ${esc(a)}</p>`).join('');
        box.hidden = false;
      } else {
        // Resolved alerts must clear on the next poll, not linger stale.
        box.innerHTML = '';
        box.hidden = true;
      }
    } catch { /* alerts are advisory; their absence is not an error */ }
  }

  // ── Admin & upgrades (v3.6): /api/v1/governance ─────────────────────────
  const ZERO = '0x0000000000000000000000000000000000000000';
  const shortAddr = (a: string) => (a && a.length >= 10 ? `${a.slice(0, 6)}…${a.slice(-4)}` : a || '—');
  const addrLink = (a: string) =>
    a && a !== ZERO && EXPLORER ? `<a href="${esc(EXPLORER)}/address/${esc(a)}" rel="noopener" class="mono">${esc(shortAddr(a))}</a>` : `<span class="mono">${esc(shortAddr(a))}</span>`;
  const GOV_COPY: Record<string, (e: any) => string> = {
    KeeperSet: () => 'Keeper replaced',
    AdminTransferStarted: () => 'Admin hand-over offered',
    AdminTransferCancelled: () => 'Admin hand-over withdrawn',
    AdminTransferred: () => 'Admin changed',
    AdminRenounced: () => 'Admin gave up control — contracts immutable',
    UpgradeQueued: () => 'Contract upgrade queued',
    UpgradeCancelled: () => 'Contract upgrade cancelled',
    Upgraded: () => 'Contract upgraded',
    AuditLog: (e) => `Audit: ${e.extra || 'action'}`,
  };
  const ago = (iso: string) => {
    const s = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000);
    if (s < 90) return 'just now';
    if (s < 3600) return `${Math.round(s / 60)} min ago`;
    if (s < 172800) return `${Math.round(s / 3600)} h ago`;
    return `${Math.round(s / 86400)} days ago`;
  };
  async function loadGovernance() {
    const set = (id: string, html: string) => (document.getElementById(id)!.innerHTML = html);
    let g: any = null;
    try {
      const r = await fetch('/api/v1/governance');
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      g = await r.json();
    } catch {
      set('gov-rows', '<tr><td colspan="4" class="muted">Governance data is unavailable right now.</td></tr>');
      return;
    }
    if (!g.deployed) {
      set('gov-lead', 'No contracts on this network yet — nothing to administer.');
      document.getElementById('gov-tiles')!.hidden = true;
      document.getElementById('gov-table')!.hidden = true;
      return;
    }
    const live = g.live ?? {};
    const alertBox = document.getElementById('gov-alert')!;
    if (live.error) {
      alertBox.innerHTML = `<p>⚠ Could not read the chain (${esc(live.error)}). Showing the last indexed state.</p>`;
      alertBox.hidden = false;
    } else {
      alertBox.hidden = true; alertBox.innerHTML = '';
    }
    set('gov-admin', addrLink(live.admin || ''));
    set('gov-admin-kind', live.renounced ? 'renounced — immutable' : live.admin_is_contract ? 'multisig (Safe)' : live.admin ? 'single wallet' : '');
    set('gov-pending', live.pending_admin && live.pending_admin !== ZERO ? addrLink(live.pending_admin) : 'none');
    set('gov-keeper', addrLink(live.keeper || ''));
    set('gov-delay', live.error ? '—' : `${live.upgrade_delay ?? 0}s (instant)`);
    // Keeper wallet (v3.6 wave 6): balance + level from the keeper-health worker.
    const kh = g.keeper_health;
    const toNative = (wei: string) => { try { const w = BigInt(wei || '0'); const whole = w / 10n ** 18n; const frac = ((w % 10n ** 18n) / 10n ** 14n).toString().padStart(4, '0'); return `${whole}.${frac}`; } catch { return '—'; } };
    if (kh && kh.level && kh.level !== 'disabled') {
      set('gov-keeper-bal', kh.level === 'unknown' ? '—' : `${toNative(kh.balance_wei)} ${esc(kh.currency || '')}`);
      set('gov-keeper-bal-sub', kh.level === 'ok' ? `min ${toNative(kh.min_wei)}` : kh.level === 'unknown' ? 'balance read failed' : `${kh.level.toUpperCase()} — min ${toNative(kh.min_wei)}`);
      if (kh.level === 'warning' || kh.level === 'critical') {
        alertBox.innerHTML += `<p>⚠ Keeper wallet is ${kh.level === 'critical' ? 'critically ' : ''}low: ${esc(toNative(kh.balance_wei))} ${esc(kh.currency || '')} (minimum ${esc(toNative(kh.min_wei))}). Settlements fail under gas spikes until it is topped up.</p>`;
        alertBox.hidden = false;
      }
      if ((kh.fee_cap_below_for ?? 0) >= 3) {
        alertBox.innerHTML += `<p>⚠ The keeper's gas cap (${esc(String(kh.fee_cap_gwei))} gwei) has been below the network's suggested fee (${esc(String(Math.round(kh.suggested_gwei)))} gwei) for ${esc(String(kh.fee_cap_below_for))} checks — keeper transactions are being rejected as underpriced.</p>`;
        alertBox.hidden = false;
      }
    } else {
      set('gov-keeper-bal', '—');
      set('gov-keeper-bal-sub', kh ? 'check disabled' : '');
    }
    // Pending upgrades: per proxy, the newest lifecycle event (block, then log
    // index) decides. Only a later Upgraded/UpgradeCancelled on the SAME
    // contract clears a queued one — a different core upgrading must not hide it.
    const later = (a: any, b: any) => a.block_number > b.block_number || (a.block_number === b.block_number && a.log_index > b.log_index);
    const latestByContract: Record<string, any> = {};
    for (const e of g.events ?? []) {
      if (!['UpgradeQueued', 'UpgradeCancelled', 'Upgraded'].includes(e.event)) continue;
      const cur = latestByContract[e.contract];
      if (!cur || later(e, cur)) latestByContract[e.contract] = e;
    }
    for (const e of Object.values(latestByContract)) {
      if (e.event === 'UpgradeQueued') {
        alertBox.innerHTML += `<p>⚠ An upgrade of ${esc(shortAddr(e.contract))} to ${esc(shortAddr(e.subject))} is queued and not yet installed.</p>`;
        alertBox.hidden = false;
      }
    }
    const events = (g.events ?? []).filter((e: any) => e.event !== 'AuditLog');
    set('gov-rows', events.length === 0
      ? '<tr><td colspan="4" class="muted">Nothing queued. No admin or keeper changes recorded.</td></tr>'
      : events.map((e: any) => {
          const what = (GOV_COPY[e.event] ?? (() => e.event))(e);
          const who = [e.actor && e.actor !== ZERO ? `from ${shortAddr(e.actor)}` : '', e.subject ? `→ ${shortAddr(e.subject)}` : ''].filter(Boolean).join(' ');
          const tx = e.tx_hash ? (EXPLORER ? `<a href="${esc(EXPLORER)}/tx/${esc(e.tx_hash)}" rel="noopener">${esc(e.tx_hash.slice(0, 10))}…</a>` : esc(e.tx_hash.slice(0, 10))) : '—';
          return `<tr><td title="${esc(e.block_time)}">${esc(ago(e.block_time))}</td><td>${esc(what)}</td><td class="mono">${esc(who)}</td><td class="mono">${tx}</td></tr>`;
        }).join(''));
  }

  loadService();
  loadGovernance();
  load();
  setInterval(() => { loadService(); loadGovernance(); load(); }, 30000);
</script>

<style>
  .gas { max-width: 68rem; margin: 0 auto; padding: 3rem 1.5rem 6rem; }
  .gas-head h1 { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 900; letter-spacing: -0.025em; color: var(--text); margin: 0 0 0.5rem; }
  .gas-head p { color: var(--white-60); margin: 0 0 2rem; }
  h2 { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--white-40); margin: 2.5rem 0 1rem; }

  .gas-alerts { background: rgba(251,191,36,0.1); border: 1px solid rgba(251,191,36,0.3); border-radius: 0.75rem; padding: 0.875rem 1rem; margin: 1.5rem 0 0; color: #fcd34d; font-size: 0.875rem; }
  .gas-alerts p { margin: 0 0 0.375rem; }
  .gas-alerts p:last-child { margin: 0; }

  .gas-tiles { display: grid; gap: 1px; background: var(--white-10); border: 1px solid var(--white-10); border-radius: 0.875rem; overflow: hidden; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); }
  .tile { background: var(--surface); padding: 1rem 1.125rem; }
  .tile .k { display: block; font-size: 0.625rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--white-40); margin-bottom: 0.5rem; }
  .tile .v { display: block; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 1.125rem; font-weight: 700; color: var(--text); font-variant-numeric: tabular-nums; }
  .tile .sub { display: block; font-size: 0.75rem; color: var(--white-60); margin-top: 0.25rem; }
  .lead { color: var(--white-60); margin: -0.5rem 0 1rem; font-size: 0.9375rem; }
  .tile .v a { color: #7dd3fc; text-decoration: none; }

  .bar-row { display: grid; grid-template-columns: 10rem 1fr auto; gap: 0.875rem; align-items: center; margin-bottom: 0.625rem; font-size: 0.8125rem; }
  .bar-label { color: var(--white-80); }
  .bar-track { height: 0.5rem; background: var(--white-10); border-radius: 999px; overflow: hidden; }
  .bar-fill { display: block; height: 100%; border-radius: 999px; }
  .bar-val { font-family: 'JetBrains Mono', ui-monospace, monospace; color: var(--white-60); font-size: 0.75rem; white-space: nowrap; }

  .tablewrap { overflow-x: auto; border: 1px solid var(--white-10); border-radius: 0.875rem; }
  table { width: 100%; min-width: 40rem; border-collapse: collapse; font-size: 0.8125rem; }
  th, td { text-align: left; padding: 0.625rem 0.875rem; border-bottom: 1px solid var(--white-10); }
  th { font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--white-40); background: var(--white-10); }
  tbody tr:last-child td { border-bottom: none; }
  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
  .mono a { color: #7dd3fc; }
  .muted { color: var(--white-40); }

  @media (max-width: 640px) { .bar-row { grid-template-columns: 1fr; gap: 0.25rem; } }
</style>
