---
// Market metrics (spec B4 "Metrics"): tile captions 12px via tokens, charts
// hidden until there is data ("Charts appear after the first sale"), and an
// activity feed with relative time, a status chip and a token link, filtered
// client-side by a [24h · 7d · 30d] segmented control (pages/metrics/_range.ts).
import BaseLayout from '../layouts/BaseLayout.astro';
import WalletConnect from '../components/WalletConnect';
---

<BaseLayout title="Market Metrics" description="Real-time MagicWebb marketplace statistics — listings, sales, auctions, volume" activeNav="/metrics">
  <WalletConnect slot="wallet" client:only="react" />

  <section class="mx">
    <header class="mx-head">
      <h1>Market Metrics</h1>
      <p>Real-time marketplace statistics and activity.</p>
    </header>

    <!-- Loading skeleton for the tiles -->
    <div id="metrics-loading" class="mx-tiles" aria-hidden="true">
      <div class="mx-tile mx-skel"></div>
      <div class="mx-tile mx-skel"></div>
      <div class="mx-tile mx-skel"></div>
      <div class="mx-tile mx-skel"></div>
    </div>

    <!-- Metric tiles (populated by the script) -->
    <div id="metrics-grid"></div>

    <!-- Charts: hidden until the first sale exists. -->
    <div id="chart-note" class="mx-note" hidden>Charts appear after the first sale.</div>
    <div id="chart-section" hidden>
      <div class="mx-charts">
        <div class="mx-chartbox">
          <h3 class="mx-cap"><span class="mx-dot" style="background:var(--sky)"></span> Marketplace Overview</h3>
          <canvas id="bar-chart" width="400" height="240"></canvas>
        </div>
        <div class="mx-chartbox">
          <h3 class="mx-cap"><span class="mx-dot" style="background:var(--gold)"></span> Distribution</h3>
          <canvas id="donut-chart" width="200" height="200"></canvas>
        </div>
      </div>
    </div>

    <!-- Recent activity + time range -->
    <div class="mx-actbar">
      <h2>Recent Activity</h2>
      <div id="range-seg" class="mx-seg" role="group" aria-label="Time range">
        <button type="button" data-range="24h" aria-pressed="true">24h</button>
        <button type="button" data-range="7d" aria-pressed="false">7d</button>
        <button type="button" data-range="30d" aria-pressed="false">30d</button>
      </div>
    </div>
    <div id="activity-feed">
      <div class="mx-note">Loading activity…</div>
    </div>
  </section>
</BaseLayout>

<script>
  import { esc, shortAddr, timeAgo, fmtPrice } from '../lib/format';
  import { filterByRange, rowTimeMs, type RangeKey } from './metrics/_range';

  const cur = () => (window as any).MW_NATIVE_CURRENCY || 'C2FLR';

  type ActivityRow = {
    type?: string; status?: string; token_url?: string;
    collection?: string; tokenId?: string; token_id?: string;
    amountWei?: string; ts?: string | number; timestamp?: string;
  };

  let range: RangeKey = '24h';
  let allActivity: ActivityRow[] = [];

  // Closure state the chart redraws read.
  let listings = 0, sales = 0, auctions = 0, bids = 0, offers = 0, volFLR = '0';

  const $ = (id: string) => document.getElementById(id);

  function tile(caption: string, valueHtml: string, accent: string): string {
    return `<div class="mx-tile" style="border-color:${accent}40">
      <span class="mx-tilecap">${esc(caption)}</span>
      <span class="mx-tileval" style="color:${accent}">${valueHtml}</span>
    </div>`;
  }

  function renderTiles() {
    const g = $('metrics-grid');
    if (!g) return;
    g.innerHTML = `<div class="mx-tiles">
      ${tile('Active listings', String(listings), 'var(--sky)')}
      ${tile('Total sales', String(sales), 'var(--gold)')}
      ${tile('Total auctions', String(auctions), 'var(--violet)')}
      ${tile('Gross volume', `${esc(volFLR)} <span class="mx-unit">${esc(cur())}</span>`, 'var(--text)')}
      ${tile('Total bids', String(bids), 'var(--sky)')}
      ${tile('Total offers', String(offers), 'var(--gold)')}
    </div>`;
  }

  // ── Canvas charts (drawn only once there is at least one sale) ──────────
  function drawBarChart() {
    const canvas = $('bar-chart') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;
    const w = canvas.width, h = canvas.height;
    const pad = { t: 20, b: 30, l: 40, r: 20 };
    const cw = w - pad.l - pad.r;
    const ch = h - pad.t - pad.b;
    const data = [
      { label: 'Listings', value: listings, color: '#7dd3fc' },
      { label: 'Sales', value: sales, color: '#fcd34d' },
      { label: 'Auctions', value: auctions, color: '#a78bfa' },
      { label: 'Bids', value: bids, color: '#67e8f9' },
      { label: 'Offers', value: offers, color: '#fbbf24' },
      { label: 'Volume', value: parseFloat(volFLR) || 0, color: 'rgba(255,255,255,0.5)' },
    ];
    const maxV = Math.max(...data.map((d) => d.value)) || 1;
    const gap = cw / data.length;
    const barW = gap * 0.6;
    ctx.clearRect(0, 0, w, h);
    data.forEach((d, i) => {
      const x = pad.l + i * gap + (gap - barW) / 2;
      const bh = (d.value / maxV) * ch * 0.85;
      const y = pad.t + ch - bh;
      const r = 4;
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.lineTo(x + barW - r, y);
      ctx.arcTo(x + barW, y, x + barW, y + r, r);
      ctx.lineTo(x + barW, pad.t + ch);
      ctx.lineTo(x, pad.t + ch);
      ctx.lineTo(x, y + r);
      ctx.arcTo(x, y, x + r, y, r);
      ctx.fillStyle = d.color;
      ctx.globalAlpha = 0.8;
      ctx.fill();
      ctx.globalAlpha = 1;
      ctx.fillStyle = '#fafafa';
      ctx.font = 'bold 12px Inter, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(d.value.toLocaleString(), x + barW / 2, y - 6);
      ctx.fillStyle = 'rgba(255,255,255,0.3)';
      ctx.font = '10px Inter, sans-serif';
      ctx.fillText(d.label, x + barW / 2, pad.t + ch + 16);
    });
  }

  function drawDonutChart() {
    const canvas = $('donut-chart') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;
    const cx = canvas.width / 2, cy = canvas.height / 2, r = 70, ir = 40;
    // Event counts only: native-token volume has a different unit and must
    // not be summed into the slices or the center total.
    const total = listings + sales + auctions + bids + offers;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    if (total === 0) return;
    const segments = [
      { value: listings, color: '#7dd3fc', label: 'Listings' },
      { value: sales, color: '#fcd34d', label: 'Sales' },
      { value: auctions, color: '#a78bfa', label: 'Auctions' },
      { value: bids, color: '#67e8f9', label: 'Bids' },
      { value: offers, color: '#fbbf24', label: 'Offers' },
    ];
    let start = -Math.PI / 2;
    segments.forEach((seg) => {
      const sweep = (seg.value / total) * 2 * Math.PI;
      ctx.beginPath();
      ctx.moveTo(cx + ir * Math.cos(start), cy + ir * Math.sin(start));
      ctx.arc(cx, cy, r, start, start + sweep);
      ctx.arc(cx, cy, ir, start + sweep, start, true);
      ctx.closePath();
      ctx.fillStyle = seg.color;
      ctx.globalAlpha = 0.85;
      ctx.fill();
      ctx.globalAlpha = 1;
      start += sweep;
    });
    ctx.fillStyle = '#fafafa';
    ctx.font = 'bold 18px Inter, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(total.toLocaleString(), cx, cy - 6);
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = '9px Inter, sans-serif';
    ctx.fillText('total', cx, cy + 14);
    const legendStartY = canvas.height - 24;
    segments.forEach((seg, i) => {
      const lx = 4 + (i % 3) * 62;
      const ly = legendStartY + Math.floor(i / 3) * 12;
      ctx.fillStyle = seg.color;
      ctx.fillRect(lx, ly - 4, 6, 6);
      ctx.fillStyle = 'rgba(255,255,255,0.4)';
      ctx.font = '8px Inter, sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText(seg.label, lx + 8, ly + 1);
    });
  }

  /** Charts only once real data exists (spec: "Charts appear after the first sale"). */
  function renderCharts() {
    const section = $('chart-section');
    const note = $('chart-note');
    const hasData = sales > 0;
    if (section) section.hidden = !hasData;
    if (note) note.hidden = hasData;
    if (hasData) setTimeout(() => { drawBarChart(); drawDonutChart(); }, 50);
  }

  // ── Activity feed ────────────────────────────────────────────────────────
  const STATUS_CLASS: Record<string, string> = {
    active: 'is-active', sold: 'is-sold', expired: 'is-expired', cancelled: 'is-cancelled',
  };

  function tokenHref(a: ActivityRow): string {
    if (a.token_url) return a.token_url;
    const tid = a.tokenId ?? a.token_id;
    if (a.collection && tid !== undefined && tid !== null && tid !== '') {
      return `/token/${encodeURIComponent(a.collection)}/${encodeURIComponent(String(tid))}`;
    }
    return '';
  }

  function renderActivity() {
    const feed = $('activity-feed');
    if (!feed) return;
    const rows = filterByRange(allActivity, range);
    if (!rows.length) {
      feed.innerHTML = `<div class="mx-note">No activity in the last ${esc(range)}.</div>`;
      return;
    }
    feed.innerHTML = `<div class="mx-list">` + rows.map((a) => {
      const status = String(a.status || '').toLowerCase();
      const chip = status
        ? `<span class="mx-chip ${STATUS_CLASS[status] ?? ''}">${esc(status)}</span>`
        : '';
      const href = tokenHref(a);
      const tid = a.tokenId ?? a.token_id;
      const tokenLabel = `${esc(shortAddr(a.collection || ''))}${tid ? ' #' + esc(String(tid)) : ''}`;
      const token = href
        ? `<a class="mx-token mono" href="${esc(href)}">${tokenLabel}</a>`
        : `<span class="mx-token mono">${tokenLabel}</span>`;
      const t = rowTimeMs(a);
      const when = t === null ? '' : `<span class="mx-when">${esc(timeAgo(t))}</span>`;
      const amt = a.amountWei && a.amountWei !== '0'
        ? `<span class="mx-amt mono">${esc(fmtPrice(a.amountWei))} <span class="mx-unit">${esc(cur())}</span></span>`
        : '';
      return `<div class="mx-row">
        <span class="mx-type">${esc(a.type || '')}</span>
        ${chip}
        ${token}
        <span class="mx-spacer"></span>
        ${amt}
        ${when}
      </div>`;
    }).join('') + `</div>`;
  }

  async function loadActivity() {
    try {
      const r = await fetch('/api/v1/activity?limit=100');
      if (!r.ok) { $('activity-feed')!.innerHTML = '<div class="mx-note">Activity unavailable</div>'; return; }
      const rows = await r.json();
      allActivity = Array.isArray(rows) ? rows : [];
      renderActivity();
    } catch { /* keep whatever is on screen */ }
  }

  async function loadMetrics() {
    const m = await fetch('/api/v1/metrics').then((r) => (r.ok ? r.json() : null)).catch(() => null);
    const loadingEl = $('metrics-loading');
    if (loadingEl) loadingEl.style.display = 'none';
    if (!m) {
      const g = $('metrics-grid');
      if (g && !g.innerHTML) g.innerHTML = '<div class="mx-note">Could not load metrics — retrying shortly.</div>';
      return;
    }
    listings = m.listing_count || m.totalActiveListings || 0;
    sales = m.sales_count || m.totalSales || 0;
    auctions = m.auction_count || m.totalAuctions || 0;
    bids = m.totalBids || 0;
    offers = m.totalOffers || 0;
    volFLR = fmtPrice(m.grossVolumeWei || m.volume_all || '0');
    renderTiles();
    renderCharts();
  }

  // Segmented control
  $('range-seg')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-range]') as HTMLButtonElement | null;
    if (!btn) return;
    range = btn.dataset.range as RangeKey;
    document.querySelectorAll('#range-seg button').forEach((b) =>
      b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));
    renderActivity();
  });

  // WebSocket live refresh — re-fetch in place, never a reload.
  window.addEventListener('mw-ws-event', (e: Event) => {
    const d = (e as CustomEvent).detail;
    if (d && (d.type === 'listing-updated' || d.type === 'auction-updated' || d.type === 'activity')) {
      void loadMetrics();
      void loadActivity();
    }
  });

  void loadMetrics();
  void loadActivity();
</script>

<!-- Global (unscoped): most of these classes land on JS-generated innerHTML,
     which never carries Astro's scoping attribute — a scoped block would not
     match them. Prefixed `mx-` to avoid collisions. -->
<style is:global>
  .mx { max-width: 80rem; margin: 0 auto; padding: var(--sp-8) var(--sp-6) var(--sp-12); }
  .mx-head { margin-bottom: var(--sp-6); }
  .mx-head h1 { font-size: var(--fs-h1); line-height: var(--lh-h1); font-weight: 800; letter-spacing: -0.02em; color: var(--text); margin: 0 0 var(--sp-1); }
  .mx-head p { color: var(--text-3); font-size: var(--fs-small); margin: 0; }

  .mx-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--sp-4); margin-bottom: var(--sp-6); }
  .mx-tile { padding: var(--sp-4); border-radius: var(--r-card); background: var(--surface); border: 1px solid var(--line); }
  .mx-skel { min-height: 84px; animation: mx-pulse 1.2s ease-in-out infinite; }
  @keyframes mx-pulse { 0%, 100% { opacity: 0.4; } 50% { opacity: 0.8; } }
  @media (prefers-reduced-motion: reduce) { .mx-skel { animation: none; } }
  /* Spec: tile captions 12px (--fs-caption) at --text-3. */
  .mx-tilecap { display: block; font-size: var(--fs-caption); line-height: var(--lh-caption); letter-spacing: var(--ls-caption); text-transform: uppercase; font-weight: 700; color: var(--text-3); margin-bottom: var(--sp-2); }
  .mx-tileval { display: block; font-size: 32px; font-weight: 900; line-height: 1; }
  .mx-unit { font-size: var(--fs-caption); font-weight: 600; color: var(--text-3); }

  .mx-note { padding: var(--sp-6); border-radius: var(--r-card); background: var(--surface); border: 1px dashed var(--line-strong); color: var(--text-2); font-size: var(--fs-body); text-align: center; margin-bottom: var(--sp-6); }

  .mx-charts { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); margin-bottom: var(--sp-6); }
  @media (max-width: 767px) { .mx-charts { grid-template-columns: 1fr; } }
  .mx-chartbox { padding: var(--sp-4); border-radius: var(--r-card); background: var(--surface); border: 1px solid var(--line); }
  .mx-chartbox canvas { width: 100%; height: auto; max-height: 240px; }
  .mx-cap { display: flex; align-items: center; gap: var(--sp-2); font-size: var(--fs-caption); line-height: var(--lh-caption); letter-spacing: var(--ls-caption); text-transform: uppercase; font-weight: 700; color: var(--text-3); margin: 0 0 var(--sp-3); }
  .mx-dot { display: inline-block; width: 8px; height: 8px; border-radius: 2px; }

  .mx-actbar { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); flex-wrap: wrap; margin: var(--sp-6) 0 var(--sp-4); }
  .mx-actbar h2 { font-size: var(--fs-h2); line-height: var(--lh-h2); font-weight: 800; color: var(--text); margin: 0; }
  .mx-seg { display: inline-flex; border: 1px solid var(--line-strong); border-radius: var(--r-control); overflow: hidden; }
  .mx-seg button { min-height: 40px; min-width: 56px; padding: 0 var(--sp-3); background: transparent; border: 0; color: var(--text-2); font-family: inherit; font-size: var(--fs-small); font-weight: 700; cursor: pointer; }
  .mx-seg button + button { border-left: 1px solid var(--line); }
  .mx-seg button[aria-pressed='true'] { background: var(--sky-12); color: var(--sky-300); }
  @media (max-width: 767px) { .mx-seg button { min-height: var(--hit); } }

  .mx-list { display: flex; flex-direction: column; gap: var(--sp-2); }
  .mx-row { display: flex; align-items: center; gap: var(--sp-3); flex-wrap: wrap; padding: var(--sp-3) var(--sp-4); min-height: 52px; border-radius: var(--r-card); background: var(--surface); border: 1px solid var(--line); font-size: var(--fs-small); }
  .mx-type { font-weight: 700; color: var(--text); text-transform: uppercase; font-size: var(--fs-caption); letter-spacing: var(--ls-caption); }
  .mx-chip { padding: 2px 10px; border-radius: var(--r-pill); font-size: var(--fs-caption); font-weight: 700; text-transform: uppercase; letter-spacing: var(--ls-caption); background: rgba(255,255,255,0.06); color: var(--text-2); }
  .mx-chip.is-active { background: var(--green-12); color: var(--green); }
  .mx-chip.is-sold { background: var(--gold-12); color: var(--gold-300); }
  .mx-chip.is-expired { background: rgba(255,255,255,0.06); color: var(--text-3); }
  .mx-chip.is-cancelled { background: var(--red-12); color: var(--red); }
  .mx-token { color: var(--text-2); }
  a.mx-token { text-decoration: underline; text-underline-offset: 2px; }
  a.mx-token:hover { color: var(--text); }
  .mx-spacer { flex: 1; }
  .mx-amt { color: var(--gold-300); font-weight: 700; }
  .mx-when { color: var(--text-3); font-size: var(--fs-caption); }
  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
</style>
