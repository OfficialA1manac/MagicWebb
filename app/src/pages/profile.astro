---
// Profile (spec B4): a thin shell — ProfilePage.svelte owns everything
// (header, tabs, batch listing, refunds card, edit modal, snapshot cache).
// BaseLayout's inline bootstrap already stamps `data-mw-needs-wallet` on
// <main> for /profile* paths, so WalletConnect boots AppKit eagerly here.
import BaseLayout from '../layouts/BaseLayout.astro';
import WalletConnect from '../components/WalletConnect';
import ProfilePage from '../components/ProfilePage.svelte';
---

<BaseLayout title="Profile" description="Your MagicWebb profile — NFTs, listings, auctions, and activity" activeNav="/profile">
  <WalletConnect slot="wallet" client:only="react" />

  <section style="max-width:80rem;margin:0 auto;padding:24px 16px 48px;">
    <ProfilePage client:load />
  </section>
</BaseLayout>
