---
import BaseLayout from '../layouts/BaseLayout.astro';
import WalletConnect from '../components/WalletConnect';
import RefundsPanel from '../components/RefundsPanel.svelte';
---

<BaseLayout title="Profile" description="Your MagicWebb profile — NFTs, listings, auctions, and activity" activeNav="/profile">
  <WalletConnect slot="wallet" client:only="react" />

  <section style="max-width:80rem;margin:0 auto;padding:1.5rem 1rem 3rem;">
    <RefundsPanel client:visible />
    <div id="profile-root">
      <!-- Loading skeleton -->
      <div class="shimmer" style="display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;padding:1.5rem;border-radius:1.25rem;background:rgba(15,15,19,0.4);border:1px solid rgba(255,255,255,0.05);">
        <div style="width:4.5rem;height:4.5rem;border-radius:1rem;background:rgba(255,255,255,0.04);flex-shrink:0;"></div>
        <div style="flex:1;">
          <div class="skel-line" style="width:30%;height:1.25rem;margin-bottom:0.5rem;"></div>
          <div class="skel-line" style="width:55%;height:0.75rem;margin-bottom:0.375rem;"></div>
          <div class="skel-line" style="width:40%;height:0.75rem;"></div>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:0.75rem;margin-bottom:1.5rem;">
        <div class="shimmer" style="padding:1rem;border-radius:0.875rem;background:rgba(15,15,19,0.4);border:1px solid rgba(255,255,255,0.05);"><div class="skel-line" style="width:60%;height:0.625rem;margin-bottom:0.5rem;"></div><div class="skel-line" style="width:40%;height:1.5rem;"></div></div>
        <div class="shimmer" style="padding:1rem;border-radius:0.875rem;background:rgba(15,15,19,0.4);border:1px solid rgba(255,255,255,0.05);"><div class="skel-line" style="width:60%;height:0.625rem;margin-bottom:0.5rem;"></div><div class="skel-line" style="width:40%;height:1.5rem;"></div></div>
        <div class="shimmer" style="padding:1rem;border-radius:0.875rem;background:rgba(15,15,19,0.4);border:1px solid rgba(255,255,255,0.05);"><div class="skel-line" style="width:60%;height:0.625rem;margin-bottom:0.5rem;"></div><div class="skel-line" style="width:40%;height:1.5rem;"></div></div>
        <div class="shimmer" style="padding:1rem;border-radius:0.875rem;background:rgba(15,15,19,0.4);border:1px solid rgba(255,255,255,0.05);"><div class="skel-line" style="width:60%;height:0.625rem;margin-bottom:0.5rem;"></div><div class="skel-line" style="width:40%;height:1.5rem;"></div></div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;">
        <div class="shimmer" style="aspect-ratio:1;border-radius:1rem;background:rgba(15,15,19,0.4);border:1px solid rgba(255,255,255,0.05);"></div>
        <div class="shimmer" style="aspect-ratio:1;border-radius:1rem;background:rgba(15,15,19,0.4);border:1px solid rgba(255,255,255,0.05);"></div>
        <div class="shimmer" style="aspect-ratio:1;border-radius:1rem;background:rgba(15,15,19,0.4);border:1px solid rgba(255,255,255,0.05);"></div>
        <div class="shimmer" style="aspect-ratio:1;border-radius:1rem;background:rgba(15,15,19,0.4);border:1px solid rgba(255,255,255,0.05);"></div>
      </div>
    </div>
  </section>

  <style>
    .skel-line{background:rgba(255,255,255,0.04);border-radius:0.25rem;}
    .shimmer{animation:shimmer-placeholder 1.5s ease-in-out infinite;}
    @keyframes shimmer-placeholder{0%{opacity:0.4;}50%{opacity:0.8;}100%{opacity:0.4;}}
    @keyframes count-pop{0%{transform:scale(1);}50%{transform:scale(1.12);}100%{transform:scale(1);}}
    .count-pop{animation:count-pop 0.4s cubic-bezier(0.34,1.56,0.64,1);}
  </style>

  <!-- Global (unscoped): these classes land on JS-generated innerHTML which
       never carries Astro's scoping attribute — a scoped block would not
       match them (same trap the net-switcher rebuild comments describe). -->
  <style is:global>
    /* Grid pagination controls — match the page's inline-style aesthetic. */
    .pf-pager{display:flex;align-items:center;justify-content:center;gap:0.75rem;margin-top:1rem;}
    .pf-pager button{padding:0.375rem 0.875rem;border-radius:0.625rem;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.7);font-size:0.75rem;font-weight:700;cursor:pointer;font-family:inherit;transition:all 0.2s;}
    .pf-pager button:hover:not(:disabled){background:rgba(125,211,252,0.12);border-color:rgba(125,211,252,0.3);color:#7dd3fc;}
    .pf-pager button:disabled{opacity:0.3;cursor:not-allowed;}
    .pf-pager .pf-page-info{font-size:0.6875rem;color:rgba(255,255,255,0.35);font-weight:600;font-family:'JetBrains Mono',ui-monospace,monospace;white-space:nowrap;}
    /* The full wallet address is an unbroken 42-char mono string — without
       this it forces horizontal overflow at narrow viewports. */
    .pf-addr{overflow-wrap:anywhere;word-break:break-all;}
    /* Modest mobile type step-down (inline styles need !important to lose). */
    @media (max-width:480px){
      #profile-root h1{font-size:1.125rem !important;}
      #profile-root .count-pop{font-size:1.25rem !important;}
      #profile-root .pf-addr{font-size:0.6875rem !important;}
    }
  </style>

  <script is:inline>
    (function(){if(typeof window==='undefined')return;
      function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');}
      function weiToFLR(w,d){d=d||4;try{const bi=BigInt(w||'0');const div=BigInt('1000000000000000000');const whole=(bi/div).toString();const frac=(bi%div).toString().padStart(18,'0').slice(0,d);return whole+'.'+frac;}catch(_){return'0.'+'0'.repeat(d);}}
      function shortAddr(a){if(!a||a.length<10)return a;return a.slice(0,6)+'...'+a.slice(-4);}
      function timeAgo(t){if(!t)return'';const d=Math.floor((Date.now()-new Date(t).getTime())/1000);if(d<60)return d+'s';if(d<3600)return Math.floor(d/60)+'m';if(d<86400)return Math.floor(d/3600)+'h';return Math.floor(d/86400)+'d';}
      function resolveImageUri(uri,tid){if(!uri)return'';if(uri.startsWith('/api/v1/img/')||uri.startsWith('data:'))return uri;return'/api/v1/media?url='+encodeURIComponent(uri)+'&id='+encodeURIComponent(tid||'');}
      function cur(){return (typeof window!=='undefined'&&window.MW_NATIVE_CURRENCY)||'C2FLR';}

      function isEthAddr(s){
        if(!s||s.length!==42||s.slice(0,2)!=='0x')return false;
        for(let i=2;i<42;i++){const c=s.charCodeAt(i);if(!((c>=48&&c<=57)||(c>=65&&c<=70)||(c>=97&&c<=102)))return false;}
        return true;
      }

      // Parse address from URL or localStorage
      const addr = (function(){
    const p = window.location.pathname.replace('/profile/','').replace('/profile','');
    if (isEthAddr(p)) return p.toLowerCase();
    try { const s = localStorage.getItem('mw_addr') || ''; return isEthAddr(s) ? s.toLowerCase() : ''; } catch(_) { return ''; }
  })();

      // JWT for authenticated requests


      const root = document.getElementById('profile-root');
      if (!root) return;

      // Track last rendered address to skip no-op re-renders. Declared
      // BEFORE loadProfileData so the catch block (which resets it on
      // failure) and the mw-wallet-changed guard both reference it cleanly.
      var _lastRenderedAddr = addr;

      // Collector badge -- inline duplicate of src/lib/holderBadge.ts (inline
      // scripts cannot import). Keep the list + hash byte-identical.
      var MW_HOLDER_NAMES = ['SharinganHodl','RasenganMint','HokageWhale','PirateKingHodl','DevilFruitMint','SuperSaiyanHodl','UltraInstinctWhale','HashiraHodl','DomainExpansionMint','QuirkHodl','WaifuWhale','OtakuOG','RasenganRekt','KamehamehaHodl','ChidoriMint','GomuGomuWhale','BankaiHodl','ZanpakutoMint','TitanSlayerHodl','OdmGearWhale','AlchemistMint','PhilosopherHodl','SusanooWhale','ByakuganMint','RinneganHodl','NineTailsWhale','AkatsukiMint','JutsuHodl','SenpaiWhale','KawaiiMint','MechaHodl','GundamWhale','EvaPilotMint','SpiritGunHodl','DragonSlayerWhale','FairyTailMint','CelestialHodl','ShinigamiWhale','DeathNoteMint','StandUserHodl','OraOraWhale','MudaMudaMint','HamonHodl','NenMasterWhale','HunterMint','GreedIslandHodl','ChimeraWhale','FullCowlMint','OneForAllHodl','PlusUltraWhale','DekuMint','ShotoHodl','BakugoWhale','GojoMint','SukunaHodl','CursedEnergyWhale','BlackFlashMint','NezukoHodl','TanjiroWhale','WaterBreathingMint','ThunderclapHodl','FlameHashiraWhale','YareYareMint','StarPlatinumHodl','ZaWarudoWhale','GetsugaMint','HollowHodl','VizardWhale','SoulReaperMint','ShonenHodl','IsekaiWhale','SenseiMint','TsundereHodl','YanderaWhale','ChibiMint','NakamaHodl','MangekyoWhale','IzanagiMint','ShadowCloneHodl','SageModeWhale','CurseMarkMint','SoulSocietyHodl','GrandLineWhale','HakiMint','ConquerorsHodl','YonkoWhale','WanoMint','GearFifthHodl','SaiyanPrideWhale','FusionDanceMint','SenzuBeanHodl','NimbusWhale','SpiritBombMint','FinalFlashHodl','MajinWhale','OtakuAlpha','AnimeOG'];
      function mwHolderBadge(a){var h=0x811c9dc5>>>0;a=String(a||'').toLowerCase();for(var i=0;i<a.length;i++){h^=a.charCodeAt(i);h=Math.imul(h,0x01000193)>>>0;}return MW_HOLDER_NAMES[h%MW_HOLDER_NAMES.length];}
      // Debounce timer for wallet-changed events (prevent rapid re-renders)
      var _wcDebounceTimer = null;
      // In-flight guard: prevent overlapping loadProfileData calls
      var _loading = false;
      // Wallet change that arrived while a load was in flight — applied when
      // the in-flight load settles (see the finally block in loadProfileData).
      var _pendingAddr = null;

      // Compute isOwnProfile inside loadProfileData to stay fresh on wallet changes
      function isOwnProfileFor(targetAddr){
        const curConnected = (function(){
          try { const s = localStorage.getItem('mw_addr') || ''; return isEthAddr(s) ? s.toLowerCase() : ''; } catch(_) { return ''; }
        })();
        return curConnected && targetAddr && curConnected === targetAddr;
      }

      // Named function to load and render all profile data for a given address.
      // Called on initial page load AND on wallet change (without page reload).
      async function loadProfileData(targetAddr){
        // Prevent overlapping calls: if a load is already in-flight (e.g.
        // rapid wallet toggles beating the debounce), skip the duplicate.
        if (_loading) return;
        _loading = true;
        const encAddr = encodeURIComponent(targetAddr);
        // First paint already shows the server-rendered skeleton — keep it.
        // Only swap in the lightweight loader on later reloads (wallet switch).
        if (!root.querySelector('.shimmer')) root.innerHTML = '<div style="text-align:center;padding:2rem;opacity:0.4;"><div style="font-size:1.5rem;margin-bottom:0.5rem;">⌬</div><p style="font-size:0.8125rem;">Loading profile…</p></div>';
        try {
          const [pRes, nftRes, listRes, aucRes, offSentRes, offRecvRes, metRes, actRes] = await Promise.all([
        fetch('/api/v1/profile/'+encAddr).catch(function(){return null;}),
        fetch('/api/v1/wallet/'+encAddr+'/nfts').catch(function(){return null;}),
        fetch('/api/v1/listings?seller='+encAddr+'&limit=24').catch(function(){return null;}),
        fetch('/api/v1/auctions?seller='+encAddr+'&limit=20').catch(function(){return null;}),
        fetch('/api/v1/offers?bidder='+encAddr+'&limit=50').catch(function(){return null;}),
        fetch('/api/v1/offers?owner='+encAddr+'&limit=50').catch(function(){return null;}),
        fetch('/api/v1/metrics').catch(function(){return null;}),
        fetch('/api/v1/activity?address='+encAddr+'&limit=20').catch(function(){return null;})
      ]);
          // Creator badge: does this address own (ERC-173) any indexed collection?
          const collRes = await fetch('/api/v1/collections?limit=200').catch(function(){return null;});

          function ok(r){return r&&r.ok;}
          async function safeJson(r){try{return await r.json();}catch(_){return null;}}

          const profile     = ok(pRes)    ? (await safeJson(pRes))    : null;
          let nfts        = ok(nftRes)  ? (await safeJson(nftRes))  : [];
          let listings    = ok(listRes) ? (await safeJson(listRes)) : [];
          let auctions    = ok(aucRes)  ? (await safeJson(aucRes))  : [];
          let offersSent  = ok(offSentRes) ? (await safeJson(offSentRes)) : [];
          let offersRecv  = ok(offRecvRes) ? (await safeJson(offRecvRes)) : [];
          const metrics     = ok(metRes)  ? ((await safeJson(metRes)) || {})  : {};
          let allColls    = ok(collRes) ? (await safeJson(collRes)) : [];
          if (!Array.isArray(allColls)) allColls = [];
          const createdColls = allColls.filter(function(c){ return c && c.creator_addr && String(c.creator_addr).toLowerCase() === targetAddr.toLowerCase(); });
          let activity    = ok(actRes)  ? (await safeJson(actRes))  : [];

          if (!Array.isArray(nfts)) nfts = [];
          if (!Array.isArray(listings)) listings = [];
          if (!Array.isArray(auctions)) auctions = [];
          if (!Array.isArray(offersSent)) offersSent = [];
          if (!Array.isArray(offersRecv)) offersRecv = [];
          if (!Array.isArray(activity)) activity = [];

          const displayName = (profile && profile.display_name) || shortAddr(targetAddr);
          const bio         = (profile && profile.bio) || '';
          const avatar      = (profile && profile.avatar_uri) || '';
          // User-set tag (backend: <=32 chars, letters/digits/space/dash/_).
          // When present it replaces the deterministic collector badge pill.
          const userTag     = (profile && profile.tag) ? String(profile.tag) : '';
          // Carry-over: the profile row may come from another network's
          // deployment — show a subtle hint when source_chain differs.
          var MW_CHAIN_NAMES = {114:'Coston2',19:'Songbird',14:'Flare'};
          var srcChain = (profile && profile.source_chain) ? Number(profile.source_chain) : 0;
          var curChainId = Number((window.MW_CHAIN_ID)||'114');
          var carryOverHint = (srcChain && srcChain !== curChainId)
            ? '<p style="font-size:0.6875rem;color:rgba(255,255,255,0.3);font-style:italic;margin-top:0.375rem;">Profile from '+esc(MW_CHAIN_NAMES[srcChain]||('chain '+srcChain))+'</p>'
            : '';

          // Compute user's total earnings from listings + auctions
          const totalListedWei = listings.reduce(function(s,l){try{return s+BigInt(l.price_wei||'0');}catch(_){return s;}},0n);
          const totalSentWei   = offersSent.reduce(function(s,o){try{return s+BigInt(o.amount_wei||'0');}catch(_){return s;}},0n);
          const totalRecvWei   = offersRecv.reduce(function(s,o){try{return s+BigInt(o.amount_wei||'0');}catch(_){return s;}},0n);

          // Platform metrics
          const mListings = metrics.totalActiveListings || metrics.listing_count || 0;
          const mSales    = metrics.totalSales || metrics.sales_count || 0;
          const mAuctions = metrics.totalAuctions || metrics.auction_count || 0;
          const mVolWei   = metrics.grossVolumeWei || metrics.volume_all || '0';

          function imgTag(src, fallback){
            if(!src) return '<span style="font-size:2.5rem;color:rgba(255,255,255,0.08);">'+fallback+'</span>';
            return '<img src="'+esc(src)+'" loading="lazy" style="width:100%;height:100%;object-fit:cover;" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\';"><span style="display:none;align-items:center;justify-content:center;position:absolute;inset:0;font-size:2.5rem;color:rgba(255,255,255,0.08);">'+fallback+'</span>';
          }

          function renderNFTGrid(items, ownMode){
            if(!items||!items.length) return '<div style="padding:4rem 2rem;text-align:center;border-radius:1rem;background:rgba(15,15,19,0.5);border:1px solid rgba(255,255,255,0.05);">'+
              '<div style="font-size:2rem;margin-bottom:0.75rem;" aria-hidden="true">🖼</div>'+
              '<p style="color:rgba(255,255,255,0.55);font-size:0.875rem;font-weight:600;margin:0;">Nothing here yet</p>'+
              '<p style="color:rgba(255,255,255,0.3);font-size:0.75rem;margin-top:0.375rem;max-width:26rem;margin-left:auto;margin-right:auto;line-height:1.5;">This shows every NFT this wallet holds on <span class="mw-net-name">this network</span> — from any collection. New mints and transfers can take a minute to appear.</p>'+
            '</div>';
            return '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;">'+items.map(function(it){
              const coll=it.collection||''; const tid=it.token_id||it.tokenID||'';
              const nm=it.name||('#'+esc(tid));
              const encC=encodeURIComponent(coll); const encT=encodeURIComponent(tid);
              const src=resolveImageUri(it.image_uri,it.token_id);
              const price=it.price_wei?weiToFLR(it.price_wei,4):'';
              // Auction-escrowed tokens (merged below) have no price_wei but are
              // NOT listable — batchList would revert on them.
              const selectable=ownMode&&!price&&!it._escrowed;
              return '<a href="/token/'+encC+'/'+encT+'" class="tilt-card" style="display:block;background:rgba(15,15,19,0.6);border:1px solid rgba(255,255,255,0.07);border-radius:1rem;overflow:hidden;transition:all 0.3s;position:relative;">'+
                (selectable?'<input type="checkbox" class="mw-batch-cb" data-coll="'+esc(coll)+'" data-tid="'+esc(String(tid))+'" onclick="event.stopPropagation();" style="position:absolute;top:0.5rem;left:0.5rem;z-index:2;width:1.125rem;height:1.125rem;accent-color:#7dd3fc;cursor:pointer;" title="Select for batch listing">':'')+
                '<div style="aspect-ratio:1;overflow:hidden;background:rgba(9,9,11,0.5);position:relative;display:flex;align-items:center;justify-content:center;">'+
                  imgTag(src,'🖼')+
                  (price?'<div style="position:absolute;top:0.5rem;right:0.5rem;padding:0.25rem 0.625rem;border-radius:0.625rem;background:rgba(9,9,11,0.75);backdrop-filter:blur(8px);border:1px solid rgba(252,211,77,0.3);"><span style="font-size:0.75rem;font-weight:900;color:#fde68a;">'+esc(price)+'</span> <span style="font-size:0.5625rem;color:rgba(253,224,138,0.7);font-weight:700;">'+cur()+'</span></div>':'')+
                '</div>'+
                '<div style="padding:0.75rem;"><p style="font-size:0.5625rem;color:rgba(255,255,255,0.25);font-family:JetBrains Mono,monospace;">'+esc(shortAddr(coll))+'</p><p style="font-size:0.875rem;font-weight:700;color:#fafafa;">'+esc(nm)+'</p>'+
                (selectable?'<a href="/token/'+encC+'/'+encT+'#list" onclick="event.stopPropagation();" style="display:inline-block;margin-top:0.5rem;padding:0.25rem 0.75rem;border-radius:0.5rem;background:rgba(125,211,252,0.12);border:1px solid rgba(125,211,252,0.3);color:#7dd3fc;font-size:0.6875rem;font-weight:700;">List →</a>':'')+
                '</div></a>';
            }).join('')+'</div>';
          }

          // Batch listing: one price+duration for every selected NFT -> one tx (MW.batchList, max 50).
          function renderBatchBar(){
            var durOpts = [[60,'1m'],[180,'3m'],[300,'5m'],[600,'10m'],[900,'15m'],[1800,'30m'],[2700,'45m'],[3600,'1h'],[7200,'2h'],[14400,'4h'],[28800,'8h'],[43200,'12h'],[57600,'16h'],[72000,'20h'],[86400,'24h']];
            return '<div id="batch-bar" style="display:none;align-items:center;gap:0.625rem;flex-wrap:wrap;margin-bottom:1rem;padding:0.75rem 1rem;border-radius:0.875rem;background:rgba(125,211,252,0.06);border:1px solid rgba(125,211,252,0.25);">'+
              '<span id="batch-count" style="font-size:0.8125rem;font-weight:700;color:#7dd3fc;">0 selected</span>'+
              '<input id="batch-price" inputmode="decimal" placeholder="Price each ('+cur()+', min 1)" style="width:11rem;padding:0.45rem 0.75rem;border-radius:0.625rem;background:rgba(9,9,11,0.6);border:1px solid rgba(255,255,255,0.12);color:#fafafa;font-family:JetBrains Mono,monospace;font-size:0.8125rem;">'+
              '<select id="batch-dur" style="padding:0.45rem 0.75rem;border-radius:0.625rem;background:rgba(9,9,11,0.6);border:1px solid rgba(255,255,255,0.12);color:#fafafa;font-size:0.8125rem;font-family:inherit;">'+
                durOpts.map(function(d){return '<option value="'+d[0]+'"'+(d[0]===86400?' selected':'')+'>'+d[1]+'</option>';}).join('')+
              '</select>'+
              '<button id="batch-go" style="padding:0.5rem 1.25rem;border-radius:0.625rem;background:linear-gradient(135deg,#7dd3fc,#0ea5e9);color:#09090b;font-weight:800;font-size:0.8125rem;border:none;cursor:pointer;font-family:inherit;">List selected · free</button>'+
              '<span id="batch-err" style="font-size:0.75rem;color:#fca5a5;font-weight:600;"></span>'+
            '</div>';
          }
          function wireBatchBar(tc){
            var bar = document.getElementById('batch-bar'); if(!bar) return;
            function selected(){ return Array.prototype.slice.call(tc.querySelectorAll('.mw-batch-cb:checked')); }
            tc.addEventListener('change', function(e){
              if(!e.target || !e.target.classList || !e.target.classList.contains('mw-batch-cb')) return;
              var n = selected().length;
              bar.style.display = n ? 'flex' : 'none';
              var c = document.getElementById('batch-count'); if(c) c.textContent = n+' selected'+(n>50?' — max 50':'');
            });
            var go = document.getElementById('batch-go');
            if(go) go.addEventListener('click', function(){
              var err = document.getElementById('batch-err'); if(err) err.textContent='';
              var sel = selected();
              if(!sel.length) return;
              if(sel.length>50){ if(err) err.textContent='Pick at most 50.'; return; }
              var mw = window.MW; if(!mw){ if(err) err.textContent='Wallet bridge not ready — reload the page.'; return; }
              var priceStr = (document.getElementById('batch-price')||{}).value || '';
              var wei; try { wei = mw.toWei(priceStr); } catch(_){ if(err) err.textContent='Enter a price like 12.5'; return; }
              if(wei < 1000000000000000000n){ if(err) err.textContent='Minimum price is 1 '+cur()+'.'; return; }
              var dur = Number((document.getElementById('batch-dur')||{}).value || 86400);
              var items = sel.map(function(cb){ return { nft: cb.getAttribute('data-coll'), tokenId: cb.getAttribute('data-tid'), priceWei: wei.toString(), duration: dur }; });
              mw.batchList({ items: items }).then(function(){ setTimeout(function(){ location.reload(); }, 1500); }).catch(function(){ /* TxModal showed it */ });
            });
          }

          function renderListingsGrid(items){
            if(!items||!items.length) return '<div style="padding:4rem;text-align:center;color:rgba(255,255,255,0.2);">No active listings</div>';
            return renderNFTGrid(items); // Same visual for now
          }

          function renderAuctionsList(items){
