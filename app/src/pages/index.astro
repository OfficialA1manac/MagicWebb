---
import BaseLayout from '../layouts/BaseLayout.astro';
import WalletConnect from '../components/WalletConnect';
import HomeSections from '../components/HomeSections.svelte';
---

<BaseLayout title="Buy and sell NFTs on Flare" description="MagicWebb is a fully decentralized NFT marketplace on Flare. No account — your wallet is your login. Listing is free; you pay 2% only when something sells." activeNav="/">
  <WalletConnect slot="wallet" client:only="react" />
  <!-- Hero, first-run strip, "Right now" line, newest listings, collections
       and how-it-works all live in one island (spec B4 "Home"). The old
       document-level tilt listener and the inline fetch/badge helper copies
       are gone — cards use NFTCard, badges use lib/badge via VerifiedBadge,
       fetch-with-retry is lib/api json<T>. Hero parallax stays home-only
       (BaseLayout gates it on location.pathname === '/'). -->
  <div style="padding-bottom:3rem;">
    <HomeSections client:load />
  </div>
</BaseLayout>
