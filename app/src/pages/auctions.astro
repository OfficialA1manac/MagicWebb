---
import BaseLayout from '../layouts/BaseLayout.astro';
import WalletConnect from '../components/WalletConnect';
import AuctionsList from '../components/AuctionsList.svelte';
---

<BaseLayout title="Auctions" description="English auctions with anti-snipe protection on MagicWebb NFT Marketplace" activeNav="/auctions">
  <WalletConnect slot="wallet" client:only="react" />
  <section style="max-width:80rem;margin:0 auto;padding:1.5rem 1rem 3rem;">
    <AuctionsList client:load />
  </section>
</BaseLayout>
