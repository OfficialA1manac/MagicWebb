---
import BaseLayout from '../layouts/BaseLayout.astro';
import WalletConnect from '../components/WalletConnect';
import SearchPage from '../components/SearchPage.svelte';
---

<BaseLayout title="Search" description="Search NFTs and collections on MagicWebb" activeNav="/search">
  <WalletConnect slot="wallet" client:only="react" />
  <section style="max-width:48rem;margin:0 auto;padding:2rem 1.5rem 3rem;">
    <SearchPage client:load />
  </section>
</BaseLayout>
