{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MagicWebb network deployment record",
  "type": "object",
  "required": ["network", "chainId", "status", "contracts", "rpc", "explorer", "app"],
  "properties": {
    "network": { "enum": ["coston2", "songbird", "flare"] },
    "chainId": { "enum": [114, 19, 14] },
    "script": { "type": "string", "description": "Repo-relative path of the forge deploy script that produced (or will produce) this network's contract set." },
    "status": {
      "enum": ["deployed", "read-only", "not-deployed"],
      "description": "deployed = contracts live, full stack. read-only = Fly app + DB exist but no contracts: browsing/wallet/profile work, indexer/keepers/verifier idle, network listed in every switcher. not-deployed = no app at all."
    },
    "deployedAt": { "type": ["string", "null"] },
    "indexFromBlock": { "type": ["integer", "null"] },
    "contracts": {
      "type": "object",
      "required": ["marketplace", "auctionHouse", "offerBook", "marketplaceManager", "nft"],
      "additionalProperties": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{40}$" }
    },
    "trackedCollections": { "type": "array", "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" } },
    "rpc": { "type": "object", "required": ["primary"], "properties": { "primary": { "type": "string" }, "fallbacks": { "type": "array", "items": { "type": "string" } } } },
    "explorer": { "type": "string" },
    "app": {
      "type": "object",
      "required": ["flyApp", "origin"],
      "properties": {
        "flyApp": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "deployed" } } },
      "then": {
        "properties": {
          "contracts": {
            "properties": {
              "marketplace": { "type": "string" },
              "auctionHouse": { "type": "string" },
              "offerBook": { "type": "string" },
              "marketplaceManager": { "type": "string" },
              "nft": { "type": "string" }
            }
          },
          "indexFromBlock": { "type": "integer" }
        }
      },
      "else": {
        "properties": {
          "contracts": { "additionalProperties": { "type": "null" } }
        }
      }
    }
  ]
}
