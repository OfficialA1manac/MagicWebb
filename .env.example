
# MagicWebb — single binary (Go Fiber + HTMX)
# Copy to .env and fill in values. Run: make dev
# Ground truth for every variable is backend/internal/config/config.go.

# ── Required ──────────────────────────────────────────────────────────────────
# Neon Postgres serverless connection (port 5432). sslmode=require is enforced.
# Neon free tier: 10 concurrent connections, 500 MiB storage.
POSTGRES_URL=postgresql://user:password@ep-<project>.us-east-2.aws.neon.tech/magicwebb?sslmode=require

# Optional read-replica connection. Set to a Neon read-only branch endpoint
# to offload read-heavy API queries (listings, auctions, activity, search)
# to the replica while writes always hit the primary. Format matches the
# primary POSTGRES_URL but points to a read-only branch:
#   postgresql://user:password@ep-<branch>-reader.us-east-2.aws.neon.tech/magicwebb?sslmode=require
# The "-reader" suffix is added by Neon when creating a read-only branch.
# When unset, all reads use the primary pool — no behaviour change.
READ_POOL_URL=

RPC_URL=https://coston2-api.flare.network/ext/C/rpc
CHAIN_ID=114

# Optional rotation set: comma-separated endpoints for round-robin + <3s failover.
# Unset = single RPC_URL. Fill with the 3 public Coston2 RPCs when provisioned.
RPC_URLS=https://coston2-api.flare.network/ext/C/rpc,https://coston2.enosys.global/ext/C/rpc,https://rpc.ankr.com/flare_coston2

# Contract addresses — SOURCE OF TRUTH is deployments/coston2.json. Copy, never edit here first.
# Live Coston2 set deployed 2026-08-28 (v3.1 rules), indexed from block 34729709.
MARKETPLACE_ADDR=0x69558deFEbBBc8b7b2e09a7572abFd05435a7D30
AUCTION_ADDR=0x6286FA2C766D55d7c9f30493c1e94C8520D60fE9
OFFERBOOK_ADDR=0x840E412cb2DCF4454A950132E8BAd5C53a81118d
NFT_ADDR=0x832d74Cfbb4617B50C32cD110dfe16837A359B35
MARKETPLACE_MANAGER_ADDR=0xA4DB12d4F41c573EcCb4EBC16f50948b0487d30f

# Min 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=

# ── Optional — server ─────────────────────────────────────────────────────────
ENV=development                       # "production" disables pretty logs
HTTP_ADDR=:8080                       # listen address
FRONTEND_URL=http://localhost:8080    # CORS origin (the binary serves its own UI)
SIWE_DOMAIN=localhost                 # domain bound into the Sign-In-with-Ethereum message

# ── Optional — gRPC event bridge (cross-instance fan-out) ─────────────────────
# Replaces the old Postgres LISTEN/NOTIFY cross-instance bridge with direct
# peer-to-peer gRPC streaming. Each instance listens on GRPC_PORT and connects
# to every peer listed in GRPC_PEERS. Events are serialised as Protobuf (no 8KB
# payload cap, no DB connection drain). Unset = local-only (single instance).
GRPC_PORT=50051                       # gRPC server port for cross-instance event streaming
GRPC_PEERS=                           # comma-separated peer addresses (host:port), e.g. other-instance.internal:50051

# ── Optional — indexer tuning ─────────────────────────────────────────────────
INDEX_FROM_BLOCK=34729709             # start block for the chain indexer
GETLOGS_CHUNK=30                      # eth_getLogs chunk size (Flare public RPC caps ~30)
GETLOGS_BLOCK_CAP=30                  # max block span per request (0 = unlimited, private RPC)

# ── Optional — trending score weights ─────────────────────────────────────────
SCORE_W_VIEWS=0.3
SCORE_W_BIDS=0.5
SCORE_W_VOLUME=0.2
SCORE_DECAY=0.05

# ── Optional — keeper / admin / fee sweep ──────────────────────────────────
KEEPER_KEY=                           # hex ECDSA key; enables auction auto-settlement

# ── Optional — Gnosis Safe fee sweep (Zodiac Allowance Module) ────────────────
# Required for the fee sweep keeper to auto-transfer marketplace fees from
# the Gnosis Safe to your personal wallet. The Safe must have the Zodiac
# Allowance Module enabled and the keeper address added as a delegate (one-time
# on-chain setup after DeploySafe.s.sol runs).
SAFE_ADDR=                            # Gnosis Safe multisig address (feeRecipient)
PERSONAL_WALLET_ADDR=                 # Your personal wallet address that receives swept fees
FEE_SWEEP_MIN_WEI=100000000000000000  # Minimum Safe balance (wei) before sweeping; default 0.1 native token

# ── Optional — wallet ──────────────────────────────────────────────────────────
WC_PROJECT_ID=                        # WalletConnect v2 project id (cloud.walletconnect.com); empty = MetaMask only

# ── Optional — integrations (unset = feature off) ─────────────────────────────
ROYALTY_ADDR=                         # royalty registry contract (empty = no registry lookups)

# ── Monitoring — Sentry error reporting + OpenTelemetry tracing ────────────────
# Sentry DSN (https://sentry.io → project → Settings → Client Keys). Empty = disabled.
# When set, panics and unhandled errors are captured and sent to Sentry.
SENTRY_DSN=https://o000000.ingest.sentry.io/0000000
# OTLP/gRPC collector endpoint (e.g. Honeycomb, Grafana Tempo, Jaeger). Empty = off.
# When set, a span is created per HTTP request and exported to the collector.
# Example Honeycomb: https://api.honeycomb.io:443
# Example local Jaeger: localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Optional — chain display metadata ─────────────────────────────────────────
# Per-chain defaults come from backend/internal/chain/profile (Coston2/Songbird/
# Flare all have correct values built in), so leave these UNSET unless you are
# deliberately relabelling. Setting them OVERRIDES the profile and becomes a
# second source of truth that will silently go stale on a chain change.
# NETWORK_NAME="Flare Coston2"
# NATIVE_CURRENCY=C2FLR
# EXPLORER_URL=https://coston2-explorer.flare.network

# Network switcher destinations — comma-separated `chainID=origin` pairs. Each
# network is a SEPARATE deployment with its own API, database and /ws, so the
# switcher navigates to another host rather than switching chains in place. A
# chain absent here renders as unavailable instead of linking to a dead app.
# In CI this is generated from deployments/*.json, not from this file.
# NETWORK_URLS=114=https://magicwebb.fly.dev,19=https://magicwebb-songbird.fly.dev

# ── Optional — indexer / cache ────────────────────────────────────────────────
METADATA_CONCURRENCY=3                # max concurrent tokenURI+gateway fetches per tick
TRACKED_COLLECTIONS=                  # extra NFT contracts to index (comma-separated); listings auto-seed the rest
# REDIS_URL=redis://localhost:6379/0  # shares trending/activity cache across instances of ONE network; requires -tags redis

# ── Optional — auth ───────────────────────────────────────────────────────────
NONCE_TTL=5m                          # SIWE nonce lifetime (Go duration)

# ── Optional — keeper gas caps + alerting ─────────────────────────────────────
KEEPER_MAX_FEE_CAP_GWEI=100           # hard ceiling on keeper fee cap; 0 disables (not recommended)
KEEPER_MAX_TIP_CAP_GWEI=5             # hard ceiling on keeper tip cap; 0 disables (not recommended)
KEEPER_MIN_BALANCE_WEI=100000000000000000  # low-balance warn threshold; malformed value is fatal at boot
KEEPER_CLUSTER_SECRET=                # shared secret authenticating leader-election gossip; empty = no auth (private network only)
GAS_ALERT_THRESHOLD_WEI=500000000000000000 # 24h keeper gas spend that triggers a webhook alert
DISCORD_WEBHOOK_URL=                  # Discord/Slack-compatible webhook for gas alerts
# PROMETHEUS_WEBHOOK_URL=             # Alertmanager-compatible webhook
# SMTP_HOST=  SMTP_PORT=  SMTP_USER=  SMTP_PASS=  EMAIL_FROM=  EMAIL_TO=   # optional email alert channel

# ── Optional — secrets at rest ────────────────────────────────────────────────
# AES-256-GCM key protecting stored webhook secrets, held OUTSIDE the database.
# Hex-encoded 32 bytes (64 hex chars). Unset = secrets stored as plaintext.
# A malformed value is fatal at boot rather than a silent plaintext fallback.
# WEBHOOK_ENC_KEY=

# ── Optional — gRPC event bridge TLS ──────────────────────────────────────────
# The bridge runs plaintext by default (safe only on a private network).
# BOTH cert and key enable TLS; adding the CA cert enables mTLS.
# GRPC_TLS_CERT=/etc/tls/bridge.crt
# GRPC_TLS_KEY=/etc/tls/bridge.key
# GRPC_TLS_CA_CERT=/etc/tls/ca.crt

# ── Optional — S3-compatible blob store (IMG-3) ───────────────────────────────
# Where NFT image blob BODIES live. Empty (default) = Postgres BYTEA; "s3"
# stores bodies in S3/MinIO instead. Blob metadata (hashes, mime, refcounts)
# stays in Postgres either way, so dedup and quotas are unaffected.
IMG_STORE_BACKEND=
# S3_ENDPOINT=s3.amazonaws.com        # or play.min.io:9000 for MinIO
# S3_BUCKET=magicwebb-blobs
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_USE_SSL=true                     # exactly "true" enables HTTPS; anything else is plaintext
